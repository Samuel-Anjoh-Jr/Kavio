# TrustPro root environment file — the SINGLE source of truth for secrets.
# Copy this file to .env, fill in real values, then run `pnpm env:sync` (or
# `pnpm dev`, which runs it automatically) to fan values out to:
#   apps/web/.env.local
#   apps/api/.env
# Never edit those generated files by hand, and never commit .env itself.

PORT=4001

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
# Pooled connection used by the app at request time.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustpro?schema=public"
# Direct (non-pooled) connection used by Prisma migrations and the CI drift gate.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/trustpro?schema=public"

# ---------------------------------------------------------------------------
# Redis (BullMQ queues, rate-limit store, WebSocket pub/sub adapter)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Operational flags
# ---------------------------------------------------------------------------
# Set to "on" to serve the maintenance page instead of the app.
MAINTENANCE_MODE="off"

# ---------------------------------------------------------------------------
# JWT (Auth.js stateless access/refresh tokens) — generate with `pnpm keys`
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Bound into every token and checked on verification, so a token minted for one
# TrustPro environment cannot be replayed against another.
JWT_ISSUER="trustpro"
JWT_AUDIENCE="trustpro-web"
# Keyed digest for OTP codes, refresh tokens and reset tokens. Falls back to
# JWT_REFRESH_SECRET when unset; a leaked DB is useless without it.
AUTH_SECRET_PEPPER="test-pepper"

# ---------------------------------------------------------------------------
# Auth.js session cookie (apps/web) — generate with `pnpm keys`
# ---------------------------------------------------------------------------
AUTH_SECRET=""
# Auth.js refuses to run behind an untrusted Host header in production, which is
# what makes a self-hosted `next start` return 500 from /api/auth/session with
# `UntrustedHost` unless this is set. TrustPro is always served behind its own
# reverse proxy (which pins Host), so the check is satisfied by configuration
# rather than by trusting whatever a client sends. Set to "false" only if you
# expose Next.js directly to the internet with no proxy in front of it.
AUTH_TRUST_HOST="true"
# Where the browser reaches the API. API_INTERNAL_URL overrides it for
# server-side calls when the API is only reachable on a private network.
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_INTERNAL_URL=""
# WebSocket origin for the realtime gateway. Falls back to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL="http://localhost:4000"
# Canonical public origin used for SEO (sitemap, robots, canonical/OG URLs, llms.txt).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional SEO signals — all omitted from output when blank (never fabricated).
# Corroborating social profiles for the Organization `sameAs` (schema.org).
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_X=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
# X/Twitter handle for twitter:site / twitter:creator (e.g. "@trustpro").
NEXT_PUBLIC_TWITTER_HANDLE=""
# Search-console / AI verification tokens (bare token value, not the meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------
# OTP (ACC-04). Codes go through the notification dispatcher, never a provider.
# ---------------------------------------------------------------------------
OTP_CODE_LENGTH="6"
OTP_TTL_SECONDS="600"
# Wrong guesses allowed before the code is burned.
OTP_MAX_ATTEMPTS="5"
# Minimum gap between sends — this is the resend countdown the UI renders.
OTP_RESEND_COOLDOWN_SECONDS="60"
# Hard cap on codes issued per user+purpose inside OTP_WINDOW_SECONDS.
OTP_MAX_PER_WINDOW="5"
OTP_WINDOW_SECONDS="3600"

# ---------------------------------------------------------------------------
# Password reset (ACC-08)
# ---------------------------------------------------------------------------
PASSWORD_RESET_TTL_SECONDS="3600"
# Path on the WEB app that the emailed reset link points at.
PASSWORD_RESET_PATH="/auth/reset-password"

# ---------------------------------------------------------------------------
# VAPID (Web Push notifications) — generate with `pnpm keys`
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:security@trustpro.cm"

# ---------------------------------------------------------------------------
# Campay (Mobile Money / card / bank payments + escrow payouts, XAF)
# ---------------------------------------------------------------------------
CAMPAY_BASE_URL="https://demo.campay.net"
CAMPAY_APP_USERNAME=""
CAMPAY_APP_PASSWORD=""
CAMPAY_WEBHOOK_KEY=""
# Platform escrow fee, in basis points (1000 = 10%). Shown to the client before pay.
PLATFORM_FEE_BPS="1000"

# ---------------------------------------------------------------------------
# Verification (ID OCR, ACC tier upgrades)
# ---------------------------------------------------------------------------
VERIFICATION_OCR_ENABLED="false"
# Minimum OCR confidence (0-1) to auto-accept an extracted ID field.
VERIFICATION_OCR_MIN_CONFIDENCE="0.6"

# ---------------------------------------------------------------------------
# Safety (SOS alerts)
# ---------------------------------------------------------------------------
# Mailbox that receives SOS/safety-alert notifications.
SAFETY_ALERT_EMAIL=""

# ---------------------------------------------------------------------------
# S3 (or compatible) object storage — portfolio media, KYC docs, voice notes
# ---------------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
# Signed download URL lifetime for private objects (KYC docs, portfolio media).
S3_SIGNED_URL_TTL_SECONDS="300"
# KMS key used to encrypt KYC media (ID photos, selfies) at rest. Leave unset
# to use the bucket's default encryption.
S3_KYC_KMS_KEY_ID=""

# ---------------------------------------------------------------------------
# Mapbox GL JS (map rendering — presentation only, never authoritative math)
# ---------------------------------------------------------------------------
MAPBOX_TOKEN=""
# The browser needs its own copy: Mapbox GL JS runs client-side, so the token it
# uses is public by construction. Scope this one to a PUBLIC token with URL
# restrictions — never reuse a secret token here. Without it the app degrades to
# its no-map paths (landmark picker, list view) rather than showing a blank map.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---------------------------------------------------------------------------
# CARTO (spatial SQL + dynamic MVT tiles, served over PostGIS data)
# ---------------------------------------------------------------------------
#
# Entirely OPTIONAL. Without a key the API serves the identical MVT tiles itself
# straight from PostGIS, so the map works on a fresh checkout. CARTO is a
# delivery path over the same data, never a second copy of it.
CARTO_API_KEY=""
CARTO_BASE_URL="https://gcp-us-east1.api.carto.com"
# The CARTO connection registered against this Postgres. Tiles only route
# through CARTO when BOTH this and the API key are set.
CARTO_CONNECTION_NAME=""
# How long a rendered tile is cached (seconds). Short: the worker-density layer
# filling in is the visible proof the marketplace is growing.
GEO_TILE_CACHE_TTL_SECONDS="300"

# ---------------------------------------------------------------------------
# BigDataCloud (server-side reverse geocoding)
# ---------------------------------------------------------------------------
# Also optional — the free tier works keyless, and PostGIS answers from our own
# GeoRegion boundaries either way. A key only raises the rate limit.
BIGDATACLOUD_KEY=""
BIGDATACLOUD_BASE_URL="https://api-bdc.net/data"
# Abandon the lookup past this and let PostGIS answer. A location-setter must
# never hang on a third party.
BIGDATACLOUD_TIMEOUT_MS="2500"
# Administrative boundaries change by decree, not by session — a day is fine.
GEO_REVERSE_CACHE_TTL_SECONDS="86400"

# ---------------------------------------------------------------------------
# OpenStreetMap ingest (pnpm db:osm:ingest — Douala + Yaoundé)
# ---------------------------------------------------------------------------
# Point at your own Overpass instance for large or repeated ingests; the public
# one is a donated resource and rate-limits anonymous traffic.
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"

# ---------------------------------------------------------------------------
# Resend (branded transactional email — notification dispatcher email channel)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Notification dispatcher (SRS §17, §26.1)
# ---------------------------------------------------------------------------
# Backend for the EMAIL channel: "console" prints a branded preview to the
# terminal (dev + local OTP), "resend" delivers for real. Defaults to console
# unless RESEND_API_KEY is set.
NOTIFICATIONS_EMAIL_PROVIDER="console"
NOTIFICATIONS_EMAIL_FROM="TrustPro <no-reply@trustpro.cm>"
# SMS is DEFERRED at launch: the provider is registered but flagged OFF. Flip to
# "true" once a paid aggregator is connected — no call-site changes needed.
NOTIFICATIONS_SMS_ENABLED="false"
# Channel priority, highest first. Defaults to WEB_PUSH,EMAIL,SMS.
NOTIFICATIONS_CHANNEL_PRIORITY="WEB_PUSH,EMAIL,SMS"
# Base URL used to build deep links inside notification templates.
APP_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Social media links (footer)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK="https://facebook.com/trustpro"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://instagram.com/trustpro"
NEXT_PUBLIC_SOCIAL_LINKEDIN="https://linkedin.com/company/trustpro"
NEXT_PUBLIC_SOCIAL_X="https://x.com/trustpro"
NEXT_PUBLIC_SOCIAL_YOUTUBE="https://youtube.com/trustpro"

# ---------------------------------------------------------------------------
# SEO (marketing site meta tags + search console verification)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TWITTER_HANDLE="@trustpro"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""