{
  "name": "kavio",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.1",
    "pnpm": ">=9"
  },
  "scripts": {
    "prepare": "husky",
    "env:sync": "node scripts/sync-env.mjs",
    "dev": "pnpm env:sync && turbo run dev",
    "dev:web": "pnpm env:sync && turbo run dev --filter=@kavio/web",
    "dev:api": "pnpm env:sync && pnpm --filter @kavio/database build && turbo run dev --filter=@kavio/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@kavio/web",
    "build:api": "turbo run build --filter=@kavio/api",
    "lint": "turbo run lint",
    "lint:i18n": "eslint --config eslint.i18n.config.mjs \"apps/web/{app,components}/**/*.{ts,tsx}\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write .",
    "full-check": "pnpm lint && pnpm lint:i18n && pnpm type-check && pnpm test",
    "db:generate": "pnpm --filter @kavio/database generate",
    "db:validate": "pnpm --filter @kavio/database validate",
    "db:push": "pnpm --filter @kavio/database push",
    "db:studio": "pnpm --filter @kavio/database studio",
    "db:migrate": "pnpm --filter @kavio/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @kavio/database migrate:deploy",
    "db:migrate:reset": "pnpm --filter @kavio/database migrate:reset",
    "db:migrate:diff": "pnpm --filter @kavio/database migrate:diff",
    "db:seed": "pnpm --filter @kavio/database seed",
    "db:osm:ingest": "pnpm --filter @kavio/database osm:ingest",
    "db:admin:promote": "pnpm --filter @kavio/database admin:promote",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && pnpm db:migrate:deploy && pnpm db:generate",
    "docker:up": "docker compose up -d",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "dev:setup": "pnpm --filter @kavio/database build && pnpm db:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "backup:db": "bash scripts/docker-db-backup.sh",
    "keys": "node scripts/keygen.cjs",
    "32-bytes": "node scripts/random-bytes.mjs",
    "clean": "node scripts/clean.mjs",
    "hooks:disable": "node scripts/toggle-hooks.mjs off",
    "hooks:enable": "node scripts/toggle-hooks.mjs on"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@kavio/typescript-config": "workspace:*",
    "eslint": "^9.18.0",
    "eslint-plugin-i18next": "^6.1.5",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,mjs,cjs}": [
      "prettier --write"
    ]
  }
}
