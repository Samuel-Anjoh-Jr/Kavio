generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PostGIS is enabled via raw SQL in the initial migration (CREATE EXTENSION),
// not Prisma's declarative `extensions`: managed hosts preinstall a different
// set of PostGIS sub-extensions, and declaring them here reports false drift.

// ─────────────────────────────────────────────────────────────────────────────
// Identity (SRS §6.1, §11). One User holds many UserRole rows; tier + Trust Score
// attach to the identity, not the role, so a role switch never re-verifies.
// Later prompts add their own models + migrations (incremental schema).
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  WORKER
  CLIENT
  BUSINESS
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

/// Progressive verification tiers (SRS §21.4, TRU-02). Derived from completed
/// checks + Trust Score, never set by hand outside Admin. Held on the IDENTITY.
enum VerificationTier {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

/// A single human identity. Phone/email are unique when present. Phone is stored
/// in E.164 at capture (SMS deferred). passwordHash is nullable for OTP-only users.
///
/// `tier` and `trustScore` deliberately live HERE and not on UserRole (ACC-06):
/// switching role must never re-verify, so both attach to the identity. The full
/// Trust Engine (sub-scores, TrustEvents) lands in Phase 2 and recomputes these.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String?    @unique
  email        String?    @unique
  passwordHash String?
  name         String?
  avatar       String?
  locale       String     @default("en")
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?

  tier       VerificationTier @default(TIER_0)
  trustScore Int              @default(0)

  /// Optional second factor (ACC-08). When true, password login stops at a
  /// challenge and only a verified TWO_FACTOR code completes the session.
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?

  passwordUpdatedAt DateTime?
  /// Set whenever every session must die at once (password reset, admin action).
  /// Refresh is rejected for tokens issued before this instant; short-lived
  /// access tokens age out on their own, which is what keeps them stateless.
  sessionsRevokedAt DateTime?

  roles                   UserRole[]
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference[]
  verificationCodes       VerificationCode[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  onboarding              OnboardingProgress[]
  mediaAssets             MediaAsset[]
  workerProfile           WorkerProfile?
  clientProfile           ClientProfile?
  businessProfile         BusinessProfile?

  trustScoreRecord      TrustScore?
  trustEvents           TrustEvent[]             @relation("TrustEventSubject")
  actedTrustEvents      TrustEvent[]             @relation("TrustEventActor")
  verifications         VerificationRecord[]     @relation("VerificationSubject")
  reviewedVerifications VerificationRecord[]     @relation("VerificationReviewer")
  assignedVerifications VerificationRecord[]     @relation("VerificationAssignee")
  verificationStageActs VerificationStageEvent[] @relation("VerificationStageActor")
  endorsements          Endorsement[]            @relation("EndorsementSubject")
  authoredEndorsements  Endorsement[]            @relation("EndorsementAuthor")
  reviewedEndorsements  Endorsement[]            @relation("EndorsementReviewer")
  badges                UserBadge[]

  @@index([status, createdAt])
}

/// A role grant on an identity. `isActive` marks the currently selected role and
/// is mirrored into the `activeRole` JWT claim that RBAC guards read. Exactly one
/// row per user is active at a time (enforced in the role-switch transaction).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      Role
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth: OTP codes, refresh-token sessions, password reset (ACC-04, ACC-05, ACC-08).
// Nothing here stores a secret in the clear: codes and tokens are persisted as
// SHA-256 digests, so a database leak alone cannot be replayed against the API.
// ─────────────────────────────────────────────────────────────────────────────

/// Why a one-time code was issued. The purpose is part of the lookup, so a code
/// minted to verify a phone can never be replayed to satisfy a 2FA challenge.
enum VerificationPurpose {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  LOGIN
  TWO_FACTOR
}

/// A 6-digit one-time code. Delivered through the NotificationDispatcher only —
/// email/console at launch, SMS when the flag flips, with no change here.
model VerificationCode {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  purpose     VerificationPurpose
  /// The address the code was sent to (E.164 phone or email), kept so a code
  /// stops working if the user changes the destination mid-flow.
  destination String
  codeHash    String
  expiresAt   DateTime
  /// Wrong-guess counter; the row is dead once it reaches the configured max.
  attempts    Int                 @default(0)
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Drives both the "newest live code" lookup and the resend-window count.
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

/// A refresh-token session. Access tokens stay fully stateless (no DB read on a
/// normal request); only refresh is tracked, which is what makes logout, rotation
/// and reuse-detection possible at all. `familyId` is the rotation lineage: if a
/// token that was already rotated comes back, the whole family is revoked because
/// it means the token leaked.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
  revokedAt DateTime?
  /// Coarse device label for the new-device notice; never a fingerprint.
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
}

/// A single-use password-reset token, delivered as a link through the dispatcher.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Cross-cutting, append-only audit trail for money/verification/privileged events.
/// `requestId` ties every entry back to the structured logger + error contract.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  target    String?
  requestId String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications (SRS §17, §26.1, NOT-02). Controllers EMIT typed domain events;
// the NotificationDispatcher applies preferences, picks channels by priority and
// enqueues delivery on the BullMQ "notifications" queue. Every dispatch attempt
// lands in NotificationLog — templateKey only, never rendered content.
// ─────────────────────────────────────────────────────────────────────────────

/// Delivery channels behind the NotificationChannel interface. SMS is registered
/// but feature-flagged OFF at launch (deferred, paid API later); phone numbers are
/// already stored in E.164 so enabling it needs no call-site change.
enum NotificationChannel {
  EMAIL
  WEB_PUSH
  SMS
}

/// Preference categories (typed enum per SRS §26.1, never free-text). SECURITY is
/// listed for completeness but always bypasses preferences and forces EMAIL.
enum NotificationCategory {
  SECURITY
  ACCOUNT
  JOBS
  QUOTES
  MESSAGES
  PAYMENTS
  TRUST
  REVIEWS
  DISPUTES
  SAFETY
  MARKETING
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// One row per dispatch attempt (success or failure), written before the provider
/// is called and updated with the outcome — this is what the admin delivery
/// dashboard (P76) reads. `recipient` is the delivery address; rendered content is
/// deliberately NOT stored, only `templateKey`.
model NotificationLog {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String?             @db.Uuid
  channel      NotificationChannel
  provider     String
  recipient    String
  templateKey  String
  subject      String?
  status       NotificationStatus  @default(PENDING)
  errorMessage String?
  metadata     Json?
  createdAt    DateTime            @default(now())
  sentAt       DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, channel, createdAt])
  @@index([status, createdAt])
  @@index([templateKey, status])
}

/// Per-user channel × category opt-in, seeded with defaults at user creation.
/// A missing row is treated as enabled; security notices ignore this table.
model NotificationPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  channel   NotificationChannel
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trust Engine (SRS §6 TRU-*, §21.4 tiers, §21.5 point model, §21.6 pillars).
//
// The moat. Everything here hangs off the IDENTITY (User), never off a role, so
// a Worker who starts hiring keeps every check they have already passed.
//
// Shape of the system:
//   TrustEvent          append-only log — the only source of truth for the score
//   TrustScore          a derived SNAPSHOT of that log, safe to delete and rebuild
//   VerificationRecord  the state of each progressive check (TRU-06)
//   Document            the KYC/portfolio artefacts a check is decided on (TRU-08)
//   Endorsement         community credibility, capped + tapering (§21.6, FR-35)
//   TierConfig          the admin-tunable gates tier derivation reads (§21.4)
// ─────────────────────────────────────────────────────────────────────────────

/// The four trust pillars (SRS §21.6). Every scoring rule belongs to exactly one,
/// which is what makes the TRU-04 breakdown screen explainable rather than a
/// single opaque number.
enum TrustPillar {
  IDENTITY
  PROFESSIONAL
  MARKETPLACE
  FINANCIAL
}

/// Every scorable thing that can happen to an identity (SRS §21.5).
///
/// This enum is deliberately closed: a new way to earn or lose trust is a schema
/// change plus a rule in the point model, reviewed together — never an ad-hoc
/// delta written by whichever module happened to be running.
enum TrustEventType {
  /// Baseline granted once at sign-up (§21.5 "Starting score", +15).
  ACCOUNT_CREATED
  PHONE_VERIFIED
  ID_VERIFIED
  FIELD_VERIFIED
  PORTFOLIO_ADDED
  JOB_COMPLETED
  REPEAT_CUSTOMER
  EXCELLENT_REVIEW
  DISPUTE_UPHELD
  JOB_CANCELLED
  /// Confirmed fraudulent documents. Permanent suspension, overriding whatever
  /// score was accumulated (TRU-08, §21.5 last row).
  FAKE_DOCUMENTS_CONFIRMED
  /// Community endorsement (§21.6, FR-35): a small capped contribution that
  /// tapers away as verified job history accumulates.
  ENDORSEMENT_RECEIVED
  /// Cancels one ENDORSEMENT_RECEIVED (author retracted, moderation reversed).
  ///
  /// The ledger is append-only, so influence is withdrawn by appending its
  /// negation rather than deleting the original — the history still shows that
  /// the endorsement was given and then taken back, which is the honest record.
  ENDORSEMENT_REVOKED
}

/// An append-only entry in the trust ledger. Rows are NEVER updated or deleted —
/// a correction is a new compensating event, so the history stays auditable.
///
/// `delta` is the NOMINAL per-occurrence impact recorded at emit time, kept for
/// the audit trail and the "what changed" UI. It is not what the score is
/// computed from: recomputation replays this log through the point model so caps,
/// tapers and clamping are applied consistently (see trust-score.model.ts).
model TrustEvent {
  id         String         @id @default(uuid()) @db.Uuid
  subjectId  String         @db.Uuid
  type       TrustEventType
  pillar     TrustPillar
  delta      Int
  /// Who caused it (admin approving an ID, a client completing a job). Null for
  /// system-generated events such as ACCOUNT_CREATED.
  actorId    String?        @db.Uuid
  /// What the event points back at — "Job", "Review", "VerificationRecord" — so
  /// the breakdown can link a point change to the thing that caused it.
  sourceType String?
  sourceId   String?
  metadata   Json?
  occurredAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  subject User  @relation("TrustEventSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  actor   User? @relation("TrustEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// The replay path: every recompute reads one subject's log in order.
  @@index([subjectId, occurredAt])
  /// Milestone lookups ("has this identity ever been ID_VERIFIED?").
  @@index([subjectId, type])
  @@index([actorId, createdAt])
}

/// A derived snapshot of the trust ledger: the four sub-scores plus the total.
///
/// Purely a read cache — dropping this table and replaying TrustEvent rebuilds it
/// exactly. That is why the score can be re-derived after a scoring-rule change
/// without any data migration.
model TrustScore {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @unique @db.Uuid

  identityScore     Int @default(0)
  professionalScore Int @default(0)
  marketplaceScore  Int @default(0)
  financialScore    Int @default(0)
  /// Clamped to [0, 100]. Zero and meaningless while `suspended` is true.
  total             Int @default(0)

  /// Confirmed fraudulent documents override the numeric score entirely
  /// (TRU-08). Kept here so the override travels with the score it replaces.
  suspended        Boolean   @default(false)
  suspendedAt      DateTime?
  suspensionReason String?

  /// Denormalised tier-gate inputs (§21.4). `completedJobs` is derived from the
  /// ledger on every recompute; `averageRating` is fed by the reviews module and
  /// stays null until an identity has been rated, which leaves the Tier 3 rating
  /// gate correctly unmet rather than accidentally satisfied by a zero.
  completedJobs Int      @default(0)
  averageRating Decimal? @db.Decimal(3, 2)

  /// How many ledger rows this snapshot covers — makes a stale snapshot obvious.
  eventCount Int      @default(0)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subject User @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Default search ranking orders on the total (DIS-08, TRU-04); descending
  /// scans of this index are what Phase 3 discovery sorts on.
  @@index([total])
  @@index([suspended])
}

/// The progressive checks behind the tiers (TRU-06, §21.4).
enum VerificationCheckType {
  PHONE
  ID_SUBMITTED
  ID_APPROVED
  SELFIE_LIVENESS
  ADDRESS
  PORTFOLIO
  FIELD_VERIFICATION
  BUSINESS_REGISTRATION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// The review pipeline a submission walks (AGT-03, ADM-03).
///
/// Separate from `status` on purpose: `status` is the OUTCOME the Trust Engine
/// and the tier gates read (three values, stable forever), while `stage` is the
/// operational position in the queue that agents and admins work. Collapsing
/// them would either hide the queue from operations or leak workflow churn into
/// the scoring contract.
enum VerificationStage {
  SUBMITTED
  UNDER_REVIEW
  FIELD_CHECK
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Why a submission was turned down. A CODE rather than free text because the
/// friendly-retry copy (TRU-07) is localized EN/FR in the web catalogue and must
/// never be an English sentence typed by a reviewer into a database column.
///
/// Reviewers can still add specifics in `reason`; the code decides the tone, the
/// retry affordance, and — for CONFIRMED_FRAUDULENT — the suspension.
enum VerificationRejectionReason {
  /// Automated OCR could not read the document. "Try again in better lighting."
  OCR_UNREADABLE
  DOCUMENT_EXPIRED
  /// Name/date of birth on the document disagrees with the account.
  DETAILS_MISMATCH
  INCOMPLETE_SUBMISSION
  WRONG_DOCUMENT_TYPE
  FIELD_CHECK_FAILED
  /// Escalated for investigation. Rejects the attempt; does NOT suspend.
  SUSPECTED_FRAUD
  /// Confirmed forgery. Permanent suspension, overriding the score (TRU-08).
  CONFIRMED_FRAUDULENT
  OTHER
}

/// One attempt at one check. Rows are NOT unique per (subject, checkType): a
/// rejection must be re-submittable (TRU-06 "re-upload on rejection"), so each
/// attempt is its own row and the LATEST row per check type is the live state.
model VerificationRecord {
  id        String                @id @default(uuid()) @db.Uuid
  subjectId String                @db.Uuid
  checkType VerificationCheckType
  status    VerificationStatus    @default(PENDING)
  stage     VerificationStage     @default(SUBMITTED)

  /// Which re-submission this is, 1-based. Kept denormalised so the friendly
  /// retry can soften ("still not quite readable") without counting rows.
  attempt Int @default(1)

  /// Agent/admin currently holding the item, so two reviewers do not both work
  /// the same submission. Cleared when the item leaves their hands.
  assignedToId String? @db.Uuid
  /// Admin or Field Agent who decided it (ADM-03, TRU-09).
  reviewerId   String? @db.Uuid

  /// The coded outcome the localized retry copy is keyed on (TRU-07).
  rejectionReason VerificationRejectionReason?
  /// Reviewer's free-text detail. Shown to staff; NEVER rendered to the subject
  /// as-is — it is neither localized nor guaranteed to be kind.
  reason          String?
  /// What was asked for when a reviewer chose "request more info" (AGT-03).
  infoRequest     String?
  infoRequestedAt DateTime?

  /// Free-form check evidence (OCR confidence, GPS fix of a field visit).
  metadata Json?

  submittedAt    DateTime  @default(now())
  stageUpdatedAt DateTime  @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subject    User  @relation("VerificationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reviewer   User? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("VerificationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  documents   VerificationDocument[]
  stageEvents VerificationStageEvent[]

  /// "Latest attempt per check type for this subject" — the tier-gate read path.
  @@index([subjectId, checkType, createdAt])
  /// The admin review queue.
  @@index([status, createdAt])
  /// The pipeline board, one column per stage (AGT-03).
  @@index([stage, submittedAt])
  /// "What is on my desk right now" for one agent.
  @@index([assignedToId, stage])
}

/// The evidence a check was decided on (TRU-06, TRU-08).
///
/// A join rather than a foreign key on either side, because the relationship is
/// genuinely many-to-many in both directions: an ID check needs front AND back,
/// and one selfie can back both a liveness check and a field visit.
model VerificationDocument {
  id                   String @id @default(uuid()) @db.Uuid
  verificationRecordId String @db.Uuid
  mediaAssetId         String @db.Uuid

  createdAt DateTime @default(now())

  verificationRecord VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)
  mediaAsset         MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([verificationRecordId, mediaAssetId])
  /// "What is the review status of this document?" — the Documents area (TRU-08).
  @@index([mediaAssetId])
}

/// Every move a submission makes through the pipeline (AGT-03, NFR-SEC-05).
///
/// Append-only. This is what the per-stage counts, the average review time and
/// the approval rate are computed from — deriving them from the record's current
/// stage alone would make "how long does review take" unanswerable the moment an
/// item moves twice.
model VerificationStageEvent {
  id                   String             @id @default(uuid()) @db.Uuid
  verificationRecordId String             @db.Uuid
  /// Null for the row written when the submission first enters the pipeline.
  fromStage            VerificationStage?
  toStage              VerificationStage

  /// Null for system transitions (automated OCR moving an item on).
  actorId   String? @db.Uuid
  note      String?
  /// Ties the transition to the request that caused it, per the error contract.
  requestId String?

  createdAt DateTime @default(now())

  verificationRecord VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)
  actor              User?              @relation("VerificationStageActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([verificationRecordId, createdAt])
  /// Throughput metrics per stage over a date window.
  @@index([toStage, createdAt])
}

/// How the endorser knows the person (§21.6). A closed list keeps the weighting
/// reviewable and stops "endorsed by a friend" from reading like a credential.
enum EndorsementRelationship {
  PREVIOUS_CUSTOMER
  WORKSHOP_OWNER
  QUARTER_CHIEF
  LANDLORD
  COMMUNITY_LEADER
  COLLEAGUE
}

enum EndorsementStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A community endorsement (FR-35). Only APPROVED rows emit a trust event, and
/// their combined contribution is capped and tapers as real job history lands —
/// early credibility without diluting earned reputation.
model Endorsement {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid

  /// Set when the endorser has an account; otherwise `authorName` carries an
  /// off-platform endorser captured by a Field Agent.
  authorId     String?                 @db.Uuid
  authorName   String?
  relationship EndorsementRelationship
  quote        String
  /// 1–5 stars, validated in the DTO before it reaches here.
  rating       Int
  status       EndorsementStatus       @default(PENDING)

  /// Staff who approved, rejected or captured it. An off-platform endorsement
  /// has no accountable author, so the agent who collected it stands behind it.
  reviewedById String?   @db.Uuid
  reviewedAt   DateTime?
  /// Why it was turned down. Staff-facing; never rendered to the endorser.
  reviewNote   String?
  /// Withdrawn after approval (author retracted, moderation reversed). The trust
  /// ledger is append-only, so revocation is a compensating ENDORSEMENT_REVOKED
  /// event rather than a deletion — this column is just the current fact.
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject    User  @relation("EndorsementSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  author     User? @relation("EndorsementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("EndorsementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// One endorsement per author per subject. NULL author ids repeat freely under
  /// Postgres NULL semantics, which is exactly right: off-platform endorsements
  /// are vouched for by the capturing agent, not deduplicated by identity.
  @@unique([subjectId, authorId])
  @@index([subjectId, status, createdAt])
  @@index([authorId])
  /// The staff moderation queue.
  @@index([status, createdAt])
}

/// Milestone badges (TRU-11). Awarded by rule from trust events, never granted
/// by hand — the same discipline as tiers, for the same reason: a badge that can
/// be given as a favour is not evidence of anything.
enum BadgeType {
  /// Recruited and verified in person by a Field Agent (TRU-09, AGT-01).
  FOUNDING_PROFESSIONAL
  /// National ID approved by staff.
  IDENTITY_VERIFIED
  /// Reached Tier 2.
  VERIFIED_PROFESSIONAL
  /// Reached Tier 3.
  FIELD_VERIFIED_PROFESSIONAL
  /// Trust Score thresholds, mirroring TRUST_SCORE_THRESHOLDS in the point model.
  TRUST_SCORE_25
  TRUST_SCORE_50
  TRUST_SCORE_75
  TRUST_SCORE_90
  /// Completed-job milestones.
  FIRST_JOB
  JOBS_10
  JOBS_25
  JOBS_50
  JOBS_100
  /// Five approved community endorsements (TRU-10).
  COMMUNITY_ENDORSED
}

/// One unlocked badge (TRU-11). Milestones are PERMANENT: a Trust Score that
/// later dips does not un-ring the bell, because the badge records that the
/// thing happened, not that it is still true. Tier badges and the tier itself
/// are separate for exactly this reason — the tier demotes, the badge remembers.
model UserBadge {
  id        String    @id @default(uuid()) @db.Uuid
  subjectId String    @db.Uuid
  type      BadgeType

  /// What unlocked it — "TierChange", "TrustEvent", "FoundingIntake".
  sourceType String?
  sourceId   String?
  metadata   Json?

  awardedAt DateTime @default(now())

  subject User @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// A badge unlocks once. The unique constraint is the idempotency guarantee:
  /// a replayed event cannot double-award or re-notify.
  @@unique([subjectId, type])
  /// The trust-history timeline, newest first.
  @@index([subjectId, awardedAt])
}

/// The tier gates (§21.4), as DATA rather than literals in code.
///
/// "Thresholds are Admin-configurable" is a hard requirement, so the derivation
/// service reads every number from this table. One row per tier; the seeded rows
/// reproduce the SRS table exactly, and moving a number here moves the boundary
/// for everyone on the next recompute.
model TierConfig {
  id   String           @id @default(uuid()) @db.Uuid
  tier VerificationTier @unique

  /// Minimum Trust Score for the tier. Gates are AND-ed with the checks below.
  minScore         Int                     @default(0)
  /// Checks that must be VERIFIED. Cumulative in effect: derivation walks the
  /// tiers in order and stops at the first unmet gate, so a tier can never be
  /// skipped even if a later tier's own list happens to be satisfied.
  requiredChecks   VerificationCheckType[]
  /// Tier 3 volume/quality gates. Null means "not gated on this".
  minCompletedJobs Int?
  minAverageRating Decimal?                @db.Decimal(3, 2)

  /// Stable key for the EN/FR label + unlock copy in the web message catalogue.
  labelKey String

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Onboarding & profiles (ACC-10, TRU-05, BIZ-04 intake). PROMPTS 20, 21, 22.
//
// Onboarding is autosaved step-by-step and resumable, so the in-progress answers
// live in OnboardingProgress.data as JSON while the user is still filling them
// in. Only on completion are they materialised into the typed profile models
// below — a half-finished WorkerProfile would otherwise be indistinguishable
// from a real one to search and the Trust Engine.
// ─────────────────────────────────────────────────────────────────────────────

/// The roles that have an onboarding flow. AGENT/ADMIN are staff, onboarded by
/// TrustPro rather than self-service.
enum OnboardingRole {
  WORKER
  CLIENT
  BUSINESS
}

/// Where a stored location came from. A human-placed pin ALWAYS wins over an
/// auto-detected fix (CLAUDE.md SPATIAL), so the provenance has to be stored
/// alongside the coordinates rather than inferred later.
enum LocationSource {
  DEVICE_GPS
  HUMAN_INPUT
  REVERSE_GEOCODE
}

/// Autosave + resume state for one identity's onboarding in one role (ACC-10).
///
/// `data` is the partially-filled form. It is deliberately schemaless: the step
/// shapes are still moving, and a migration per field change would be friction
/// with no safety payoff while the answers are not yet authoritative.
///
/// `completionPercent` is DERIVED server-side from `data` on every write, never
/// sent by the client — it drives the unlockable-benefit messaging (TRU-05) and
/// a client-supplied value would let anyone claim a complete profile.
model OnboardingProgress {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @db.Uuid
  role   OnboardingRole

  currentStep       String
  data              Json      @default("{}")
  completionPercent Int       @default(0)
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One flow per identity per role — the resume lookup.
  @@unique([userId, role])
  @@index([userId])
}

/// A worker's public-facing profile (ACC-10). Tier and Trust Score are NOT here:
/// they belong to the identity on User, so a role switch never re-verifies.
model WorkerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  headline        String?
  bio             String?
  yearsExperience Int?

  /// Coarse location for discovery. The authoritative PostGIS geography column
  /// and its GIST index arrive with the spatial schema (PROMPT 38); these plain
  /// columns are what onboarding captures and are safe to backfill from.
  city           String?
  area           String?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource?

  /// Free-text landmark the worker typed ("behind Total Bonapriso"). Human input
  /// is the most reliable address format in Douala and Yaoundé, so it is stored
  /// verbatim next to the coordinates rather than being parsed into them.
  landmark          String?
  locationUpdatedAt DateTime?

  /// The administrative area the coordinates fall in, resolved server-side
  /// (PROMPT 39). Denormalised so a region filter is an equality test rather
  /// than a polygon containment check on every discovery query.
  geoRegionId String? @db.Uuid

  /// Profile cover image (PRO-01). The avatar lives on User, because it is the
  /// identity's face across every role; the cover is Worker-profile decoration
  /// and belongs here.
  coverAssetId String? @db.Uuid

  /// Authoritative spatial position (PROMPT 38, SRS §12). Maintained from
  /// latitude/longitude by the `trustpro_sync_location` trigger and indexed
  /// GIST — all distance and containment math runs against THIS column, never
  /// against the plain floats above, which exist only for display and capture.
  ///
  /// Deliberately `Unsupported`: Prisma has no geography type, and exposing it
  /// as a scalar would invite client-side spatial math the SRS forbids. Reads go
  /// through the reviewed `geo.*` views (PROMPT 40).
  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoRegion    GeoRegion?              @relation("WorkerProfileRegion", fields: [geoRegionId], references: [id], onDelete: SetNull)
  cover        MediaAsset?             @relation("WorkerProfileCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  services     Service[]
  availability Availability[]
  exceptions   AvailabilityException[]
  portfolio    PortfolioItem[]

  @@index([city])
  @@index([geoRegionId])
}

/// A client's profile (ACC-10) — deliberately minimal: hiring should not require
/// the same disclosure as offering work.
model ClientProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  displayName String?

  city           String?
  area           String?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource?

  landmark          String?
  locationUpdatedAt DateTime?
  geoRegionId       String?   @db.Uuid

  /// See WorkerProfile.location — same trigger, same GIST index, same rule.
  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoRegion GeoRegion? @relation("ClientProfileRegion", fields: [geoRegionId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([geoRegionId])
}

/// Business intake (BIZ-04). `verified` stays false here on purpose: approving a
/// business is a Trust/Admin decision (BIZ-01), never something the intake form
/// can grant itself.
model BusinessProfile {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @unique @db.Uuid

  name        String
  description String?
  /// Cameroon trade register number (RCCM). Verified in a later phase.
  rccmNumber  String?
  taxId       String?

  contactEmail String?
  contactPhone String?

  city           String?
  area           String?
  address        String?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource?

  verified   Boolean   @default(false)
  verifiedAt DateTime?

  /// Company logo (PRO-06). A MediaAsset FK rather than a URL column: the logo
  /// goes through the same upload validation, ownership and signed-access rules
  /// as every other file, and a raw URL column would be the one way to bypass
  /// them.
  logoAssetId String? @db.Uuid

  landmark          String?
  locationUpdatedAt DateTime?
  geoRegionId       String?   @db.Uuid

  /// See WorkerProfile.location — same trigger, same GIST index, same rule.
  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  geoRegion GeoRegion?           @relation("BusinessProfileRegion", fields: [geoRegionId], references: [id], onDelete: SetNull)
  logo      MediaAsset?          @relation("BusinessProfileLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  team      BusinessTeamMember[]

  @@index([city])
  @@index([geoRegionId])
}

/// Team roles and access levels per BIZ-03. Captured at intake; full team
/// management (invitations, wallets, analytics) is a later Business phase.
enum TeamMemberRole {
  ADMIN
  HR_MANAGER
  ACCOUNTANT
  STAFF
}

enum TeamMemberAccessLevel {
  FULL
  MANAGE_JOBS
  PAYMENTS
  VIEW_ONLY
}

enum TeamMemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

/// A member of a business's team. Identified by email/phone rather than a User
/// FK: at intake the person invited usually has no TrustPro account yet.
model BusinessTeamMember {
  id                String @id @default(uuid()) @db.Uuid
  businessProfileId String @db.Uuid

  name        String
  email       String?
  phone       String?
  role        TeamMemberRole        @default(STAFF)
  accessLevel TeamMemberAccessLevel @default(VIEW_ONLY)
  status      TeamMemberStatus      @default(INVITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@index([businessProfileId, status])
}

/// A service a worker offers, with transparent starting price (PRO-05).
///
/// `categoryId` stays NULLABLE (PROMPT 37). Onboarding captures the worker's own
/// words first — intake is never blocked on a taxonomy entry that an admin has
/// not created yet — and the category is attached afterwards, by the worker or
/// by moderation. Search is scoped to the taxonomy (DIS-05), so an uncategorised
/// service is reachable by name but not by category browse, which is the correct
/// incentive: it costs the worker visibility without costing them the listing.
model Service {
  id              String  @id @default(uuid()) @db.Uuid
  workerProfileId String  @db.Uuid
  categoryId      String? @db.Uuid

  name          String
  description   String?
  /// XAF has no minor unit, so prices are whole-currency integers everywhere.
  startingPrice Int?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile    @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([workerProfileId, isActive])
  /// Discovery by category (SRS §11.1) — the browse-a-category read path.
  @@index([categoryId, isActive])
}

/// The admin-managed service taxonomy search and job posting are scoped to
/// (ADM-02, DIS-05). CRUD arrives in PROMPT 43; the shape lands here.
///
/// Names are STORED bilingually rather than resolved through the web message
/// catalogue like the rest of the UI copy: this is admin-authored content that
/// changes without a deploy, so an EN/FR pair in the row is the only way both
/// locales can stay correct. Everything that is developer-authored copy stays in
/// next-intl.
model ServiceCategory {
  id   String @id @default(uuid()) @db.Uuid
  /// Stable, URL-safe key. Search filters and job posts reference the slug, so
  /// renaming a category in either language never breaks a saved filter.
  slug String @unique

  nameEn        String
  nameFr        String
  descriptionEn String?
  descriptionFr String?
  /// Icon identifier from the web icon set (e.g. "wrench"), never a URL.
  icon          String?

  /// Two-level taxonomy: a top-level trade with optional specialisations.
  parentId String? @db.Uuid

  sortOrder Int     @default(0)
  /// Retired rather than deleted (PROMPT 43): a category that has ever scoped a
  /// job or a service must keep resolving for that history to stay readable.
  isActive  Boolean @default(true)

  /// Denormalised count of workers offering at least one active service here.
  /// Recomputed by the taxonomy module, never incremented ad hoc — it drives
  /// "trending categories" (DIS-03) and the no-provider fallback copy (DIS-06),
  /// both of which are wrong in a way users notice if the number drifts.
  workerCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("ServiceCategoryTree")
  services Service[]

  /// The browse list: live categories in their admin-chosen order.
  @@index([isActive, sortOrder])
  @@index([parentId, sortOrder])
  /// Trending categories (DIS-03).
  @@index([workerCount])
}

/// A weekly availability slot. Times are local "HH:MM" strings rather than
/// DateTimes: this is a recurring weekly rule, not an instant, and storing it as
/// a timestamp would silently bind it to a date and a timezone.
model Availability {
  id              String @id @default(uuid()) @db.Uuid
  workerProfileId String @db.Uuid

  /// 0 = Sunday … 6 = Saturday, matching JavaScript's getDay().
  dayOfWeek Int
  startTime String
  endTime   String

  createdAt DateTime @default(now())

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, dayOfWeek, startTime, endTime])
  @@index([workerProfileId, dayOfWeek])
}

/// A one-off override of the weekly rule (PRO-05 "exceptions"): a public holiday
/// off, or a Sunday worked specially.
///
/// A separate model rather than a JSON column on Availability, because an
/// exception overrides the WHOLE DAY, not one slot — attaching it to a single
/// slot would leave the other slots on that day still claiming to be open.
model AvailabilityException {
  id              String @id @default(uuid()) @db.Uuid
  workerProfileId String @db.Uuid

  /// The calendar day being overridden, in the worker's local date. Stored as
  /// DATE, not a timestamp: "closed on 20 May" is not an instant, and giving it
  /// a time would bind a public holiday to whatever timezone wrote the row.
  date DateTime @db.Date

  /// False = unavailable all day (the common case). True = available on a day
  /// the weekly rule says is closed, in which case the times below apply.
  isAvailable Boolean @default(false)
  startTime   String?
  endTime     String?

  /// Worker's own words, shown to clients ("Fête du Travail").
  note String?

  createdAt DateTime @default(now())

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  /// One override per worker per day — a second one would be ambiguous.
  @@unique([workerProfileId, date])
  /// The availability filter's read path: upcoming exceptions for one worker.
  @@index([workerProfileId, date])
}

enum PortfolioItemType {
  PHOTO
  VIDEO
  PROJECT
}

/// Which half of a before/after pair an item is (PRO-02).
///
/// Nullable on the item, because most portfolio photos are neither: a single
/// finished-work shot is the common case, and forcing every upload to declare a
/// side would make the pairing meaningless.
enum PortfolioSlot {
  BEFORE
  AFTER
}

/// Portfolio evidence (PRO-02, PRO-03) — a first-class trust signal, not
/// decoration: it is the top survey-validated driver of who gets hired.
model PortfolioItem {
  id              String @id @default(uuid()) @db.Uuid
  workerProfileId String @db.Uuid
  mediaAssetId    String @db.Uuid

  type     PortfolioItemType @default(PHOTO)
  caption  String?
  /// Groups before/after pairs and multi-shot projects together.
  groupKey String?
  /// The project's name, repeated on every item in the group.
  ///
  /// Denormalised rather than normalised into a PortfolioGroup table, because a
  /// group is otherwise nothing but a title — a whole table and a join for one
  /// string. Drift is prevented at the only place that can cause it: the
  /// portfolio service rewrites the title across the WHOLE group in one
  /// transaction, so no call site can set it on a single item.
  projectTitle String?

  /// Before/after position within the group (PRO-02). Null for ordinary items.
  slot PortfolioSlot?

  /// Display order within the profile, then within a group. Client-visible
  /// ordering is an owner decision, not an accident of upload time.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, groupKey])
  /// The gallery read path: one worker's portfolio in display order (PRO-02).
  @@index([workerProfileId, sortOrder])
}

/// What an uploaded file is. Drives the access rules below.
///
/// New values are APPENDED, never reordered: Postgres `ALTER TYPE ... ADD VALUE`
/// only appends, so keeping this list in migration order is what stops the
/// schema and the database from drifting apart on the next deploy.
enum MediaAssetKind {
  PORTFOLIO_IMAGE
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  SELFIE
  BUSINESS_REGISTRATION
  BUSINESS_LOGO
  PROOF_OF_ADDRESS
  CERTIFICATE
  /// Worker profile cover image (PRO-01). Its own kind rather than reusing
  /// PORTFOLIO_IMAGE: portfolio media is evidence of work done and is counted
  /// as such by the Trust Engine, and a decorative banner must not inflate it.
  WORKER_COVER
}

/// PRIVATE media is served only through short-lived signed URLs; PUBLIC media
/// (portfolio, logos) may be served directly.
enum MediaVisibility {
  PRIVATE
  PUBLIC
}

/// A file stored in S3 (CLAUDE.md STORAGE, TRU-08). Only the object key lives in
/// the database — bytes never do, and access is decided at read time rather than
/// baked into a URL that would then be forwardable forever.
///
/// THE single storage record. PROMPT 27 folded the parallel `Document` model
/// into this one: review state (status, reviewer, rejection reason) belongs to
/// the CHECK a file was submitted for, not to the file, so it lives on
/// VerificationRecord and reaches a document through VerificationDocument. One
/// upload can therefore back several checks and carry a different outcome in
/// each, which two duplicated storage tables could never express.
model MediaAsset {
  id      String         @id @default(uuid()) @db.Uuid
  ownerId String         @db.Uuid
  kind    MediaAssetKind

  /// Object key in the bucket. Never a public URL.
  s3Key      String          @unique
  mimeType   String
  sizeBytes  Int
  visibility MediaVisibility @default(PRIVATE)

  /// SHA-256 of the bytes as stored. Two jobs: it proves the object under review
  /// is the object that was uploaded, and it catches the same ID being submitted
  /// under two accounts — the cheapest fraud signal available at upload time.
  checksum String?

  /// Soft delete. A user may retire a document from their Documents area, but
  /// the bytes behind a check that is under review (or that has already granted
  /// a tier) must survive for the audit trail — so nothing here is ever hard
  /// deleted while a verification points at it.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  owner         User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  portfolio     PortfolioItem[]
  verifications VerificationDocument[]
  workerCovers  WorkerProfile[]        @relation("WorkerProfileCover")
  businessLogos BusinessProfile[]      @relation("BusinessProfileLogo")

  @@index([ownerId, kind, createdAt])
  /// The Documents area lists live files only (TRU-08).
  @@index([ownerId, deletedAt])
  /// Duplicate-document detection across accounts.
  @@index([checksum])
}

// ─────────────────────────────────────────────────────────────────────────────
// Spatial (SRS §12, PROMPT 38). Location is layered and each layer has one job:
//
//   OSM          structural reality, ingested into the `osm` schema
//   PostGIS      the warehouse AND the authoritative maths (this file's columns)
//   CARTO        dynamic spatial SQL + MVT tiles (PROMPT 41)
//   BigDataCloud fast administrative reverse-geocoding (PROMPT 39)
//   Mapbox       paint only — NEVER authoritative for a calculation
//   Human input  a dropped pin or a landmark ALWAYS overrides a machine fix
//
// Only what the application owns is modelled here. The OSM warehouse (`osm.*`)
// and the reviewed read views (`geo.*`) live in their own Postgres schemas,
// created by raw SQL migrations: they are not Prisma's to manage, and keeping
// them out of `public` is what stops Prisma drift detection from proposing to
// drop a table it has no way to describe.
// ─────────────────────────────────────────────────────────────────────────────

/// Administrative depth of a region. Cameroon's hierarchy in the two launch
/// cities is Country → Region → City (commune) → District (arrondissement) →
/// Neighbourhood (quartier); the last is the level people actually use to say
/// where they are, which is why it is modelled rather than approximated.
enum GeoRegionLevel {
  COUNTRY
  REGION
  CITY
  DISTRICT
  NEIGHBOURHOOD
}

/// A named administrative area with a real boundary (SRS §12).
///
/// Seeded with the launch geography and then UPGRADED in place by the OSM
/// ingest: the seed carries approximate boundaries so the platform works on a
/// laptop with no network, and `osmId` is how the ingest finds the same row
/// again to replace that approximation with the real polygon. Seeding fake
/// precision and never correcting it is the failure mode this avoids.
model GeoRegion {
  id   String @id @default(uuid()) @db.Uuid
  /// Stable key ("douala-akwa"). Saved searches and shared links use this, so a
  /// renamed quarter does not break a URL someone sent on WhatsApp.
  slug String @unique

  nameEn String
  nameFr String
  level  GeoRegionLevel

  parentId String? @db.Uuid

  /// The OSM relation/way this boundary came from. Null while the row still
  /// holds its seeded approximation — which is exactly the "not yet ingested"
  /// signal the ingest script filters on.
  osmId BigInt?

  /// Authoritative boundary and centroid, GIST-indexed in the raw SQL migration.
  /// `Unsupported` on purpose: see WorkerProfile.location.
  boundary Unsupported("geography(MultiPolygon, 4326)")?
  center   Unsupported("geography(Point, 4326)")?

  /// Cached ST_Area of the boundary. Ranking a "within region" result set by
  /// specificity should not re-measure a polygon on every request.
  areaSqKm Float?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   GeoRegion?  @relation("GeoRegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children GeoRegion[] @relation("GeoRegionTree")

  workerProfiles   WorkerProfile[]   @relation("WorkerProfileRegion")
  clientProfiles   ClientProfile[]   @relation("ClientProfileRegion")
  businessProfiles BusinessProfile[] @relation("BusinessProfileRegion")

  /// The region picker: live regions at one level.
  @@index([level, isActive])
  @@index([parentId])
  /// The ingest's "find the row this OSM relation already seeded" lookup.
  @@index([osmId])
}
