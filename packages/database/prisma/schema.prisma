generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PostGIS is enabled via raw SQL in the initial migration (CREATE EXTENSION),
// not Prisma's declarative `extensions`: managed hosts preinstall a different
// set of PostGIS sub-extensions, and declaring them here reports false drift.

// ─────────────────────────────────────────────────────────────────────────────
// Identity (SRS §6.1, §11). One User holds many UserRole rows; tier + Trust Score
// attach to the identity, not the role, so a role switch never re-verifies.
// Later prompts add their own models + migrations (incremental schema).
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  WORKER
  CLIENT
  BUSINESS
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

/// Progressive verification tiers (SRS §21.4, TRU-02). Derived from completed
/// checks + Trust Score, never set by hand outside Admin. Held on the IDENTITY.
enum VerificationTier {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

/// A single human identity. Phone/email are unique when present. Phone is stored
/// in E.164 at capture (SMS deferred). passwordHash is nullable for OTP-only users.
///
/// `tier` and `trustScore` deliberately live HERE and not on UserRole (ACC-06):
/// switching role must never re-verify, so both attach to the identity. The full
/// Trust Engine (sub-scores, TrustEvents) lands in Phase 2 and recomputes these.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String?    @unique
  email        String?    @unique
  passwordHash String?
  name         String?
  avatar       String?
  locale       String     @default("en")
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?

  tier       VerificationTier @default(TIER_0)
  trustScore Int              @default(0)

  /// Optional second factor (ACC-08). When true, password login stops at a
  /// challenge and only a verified TWO_FACTOR code completes the session.
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?

  passwordUpdatedAt DateTime?
  /// Set whenever every session must die at once (password reset, admin action).
  /// Refresh is rejected for tokens issued before this instant; short-lived
  /// access tokens age out on their own, which is what keeps them stateless.
  sessionsRevokedAt DateTime?

  roles                   UserRole[]
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference[]
  verificationCodes       VerificationCode[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  onboarding              OnboardingProgress[]
  mediaAssets             MediaAsset[]
  workerProfile           WorkerProfile?
  clientProfile           ClientProfile?
  businessProfile         BusinessProfile?

  postedJobs         Job[]                @relation("JobPoster")
  jobStatusActs      JobStatusEvent[]     @relation("JobStatusActor")
  jobApplications    JobApplication[]     @relation("JobApplicationWorker")
  jobInvitations     JobInvitation[]      @relation("JobInvitationWorker")
  sentJobInvitations JobInvitation[]      @relation("JobInvitationSender")
  quotes             Quote[]              @relation("QuoteWorker")
  workerBookings     Booking[]            @relation("BookingWorker")
  clientBookings     Booking[]            @relation("BookingClient")
  bookingStatusActs  BookingStatusEvent[] @relation("BookingStatusActor")

  wallet           Wallet?
  paymentMethods   PaymentMethod[]
  transactions     Transaction[]
  clientEscrows    EscrowHold[]        @relation("EscrowClient")
  workerEscrows    EscrowHold[]        @relation("EscrowWorker")
  escrowStatusActs EscrowStatusEvent[] @relation("EscrowStatusActor")
  openedDisputes   Dispute[]           @relation("DisputeOpener")
  resolvedDisputes Dispute[]           @relation("DisputeResolver")
  disputeMessages  DisputeMessage[]    @relation("DisputeMessageAuthor")

  trustScoreRecord      TrustScore?
  trustEvents           TrustEvent[]             @relation("TrustEventSubject")
  actedTrustEvents      TrustEvent[]             @relation("TrustEventActor")
  verifications         VerificationRecord[]     @relation("VerificationSubject")
  reviewedVerifications VerificationRecord[]     @relation("VerificationReviewer")
  assignedVerifications VerificationRecord[]     @relation("VerificationAssignee")
  verificationStageActs VerificationStageEvent[] @relation("VerificationStageActor")
  endorsements          Endorsement[]            @relation("EndorsementSubject")
  authoredEndorsements  Endorsement[]            @relation("EndorsementAuthor")
  reviewedEndorsements  Endorsement[]            @relation("EndorsementReviewer")
  badges                UserBadge[]

  // Reviews (PROMPT 79; REV-01…REV-03). One identity authors some and is the
  // subject of others — after a completed job the client rates the worker and
  // the worker may rate the client back, so both sides hang off the identity.
  authoredReviews  Review[] @relation("ReviewAuthor")
  receivedReviews  Review[] @relation("ReviewSubject")
  moderatedReviews Review[] @relation("ReviewModerator")

  // Business teams (PROMPT 81; BIZ-03). A member row binds to an identity only
  // once the invitation is ACCEPTED — an invited colleague usually has no
  // TrustPro account yet — so membership is a nullable relation on both sides.
  teamMemberships    BusinessTeamMember[] @relation("TeamMemberUser")
  sentTeamInvites    BusinessTeamMember[] @relation("TeamMemberInviter")
  verifiedBusinesses BusinessProfile[]    @relation("BusinessProfileVerifier")

  // Messaging (PROMPT 70). A conversation's members are a join, not two columns
  // on the identity — so a safety observer can be added to an existing thread.
  conversationParts ConversationParticipant[] @relation("ConversationParticipantUser")
  sentMessages      Message[]                 @relation("MessageSender")
  blocksMade        Block[]                   @relation("BlockBlocker")
  blocksReceived    Block[]                   @relation("BlockBlocked")
  reportsMade       AbuseReport[]             @relation("AbuseReportReporter")
  reportsAbout      AbuseReport[]             @relation("AbuseReportReported")
  reviewedReports   AbuseReport[]             @relation("AbuseReportReviewer")

  // Safety & SOS (PROMPT 73).
  emergencyContacts EmergencyContact[]
  sosAlerts         SOSAlert[]         @relation("SOSAlertUser")
  resolvedSosAlerts SOSAlert[]         @relation("SOSAlertResolver")

  // Live tracking (PROMPT 74). One identity is the tracked subject in some
  // sessions and the consented viewer in others.
  trackedSessions TrackingSession[] @relation("TrackingSubject")
  viewerSessions  TrackingSession[] @relation("TrackingViewer")
  locationPings   LocationPing[]    @relation("LocationPingUser")

  // Web-push device registry (PROMPT 76).
  deviceRegistrations DeviceRegistration[]

  // In-app notification inbox (PROMPT 78; NOT-02).
  notifications Notification[]
  notificationSoundPreferences NotificationSoundPreference[]

  // Moderation (ADM-08). One identity is the subject of some actions and, when it
  // holds the ADMIN role, the actor on others.
  moderationAgainst ModerationAction[] @relation("ModerationSubject")
  moderationTaken   ModerationAction[] @relation("ModerationActor")

  // Admin operations (PROMPT 87, 88; ADM-02, ADM-06, ADM-07). An admin invites
  // agents and authors announcements; the accepted side of an invitation is the
  // agent's own identity, which is why both ends hang off User.
  sentAgentInvites     AgentInvitation[] @relation("AgentInvitationInviter")
  acceptedAgentInvites AgentInvitation[] @relation("AgentInvitationAcceptor")
  announcementsWritten Announcement[]    @relation("AnnouncementAuthor")
  settingsUpdated      SystemSetting[]   @relation("SystemSettingEditor")

  @@index([status, createdAt])
}

/// A role grant on an identity. `isActive` marks the currently selected role and
/// is mirrored into the `activeRole` JWT claim that RBAC guards read. Exactly one
/// row per user is active at a time (enforced in the role-switch transaction).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      Role
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth: OTP codes, refresh-token sessions, password reset (ACC-04, ACC-05, ACC-08).
// Nothing here stores a secret in the clear: codes and tokens are persisted as
// SHA-256 digests, so a database leak alone cannot be replayed against the API.
// ─────────────────────────────────────────────────────────────────────────────

/// Why a one-time code was issued. The purpose is part of the lookup, so a code
/// minted to verify a phone can never be replayed to satisfy a 2FA challenge.
enum VerificationPurpose {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  LOGIN
  TWO_FACTOR
}

/// A 6-digit one-time code. Delivered through the NotificationDispatcher only —
/// email/console at launch, SMS when the flag flips, with no change here.
model VerificationCode {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  purpose     VerificationPurpose
  /// The address the code was sent to (E.164 phone or email), kept so a code
  /// stops working if the user changes the destination mid-flow.
  destination String
  codeHash    String
  expiresAt   DateTime
  /// Wrong-guess counter; the row is dead once it reaches the configured max.
  attempts    Int                 @default(0)
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Drives both the "newest live code" lookup and the resend-window count.
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

/// A refresh-token session. Access tokens stay fully stateless (no DB read on a
/// normal request); only refresh is tracked, which is what makes logout, rotation
/// and reuse-detection possible at all. `familyId` is the rotation lineage: if a
/// token that was already rotated comes back, the whole family is revoked because
/// it means the token leaked.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
  revokedAt DateTime?
  /// Coarse device label for the new-device notice; never a fingerprint.
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
}

/// A single-use password-reset token, delivered as a link through the dispatcher.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Cross-cutting, append-only audit trail for money/verification/privileged events.
/// `requestId` ties every entry back to the structured logger + error contract.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  target    String?
  requestId String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications (SRS §17, §26.1, NOT-02). Controllers EMIT typed domain events;
// the NotificationDispatcher applies preferences, picks channels by priority and
// enqueues delivery on the BullMQ "notifications" queue. Every dispatch attempt
// lands in NotificationLog — templateKey only, never rendered content.
// ─────────────────────────────────────────────────────────────────────────────

/// Delivery channels behind the NotificationChannel interface. SMS is registered
/// but feature-flagged OFF at launch (deferred, paid API later); phone numbers are
/// already stored in E.164 so enabling it needs no call-site change.
/// IN_APP is a channel like any other — a provider that writes a Notification row
/// instead of calling out to a network. Modelling the inbox as a channel rather
/// than a side-effect is what lets NOT-02's per-channel preference grid include
/// it, and what keeps the dispatcher the only thing that fans out.
/// Appended last: Postgres enums can only be appended to.
enum NotificationChannel {
  EMAIL
  WEB_PUSH
  SMS
  IN_APP
}

/// Preference categories (typed enum per SRS §26.1, never free-text). SECURITY is
/// listed for completeness but always bypasses preferences and forces EMAIL.
enum NotificationCategory {
  SECURITY
  ACCOUNT
  JOBS
  QUOTES
  MESSAGES
  PAYMENTS
  TRUST
  REVIEWS
  DISPUTES
  SAFETY
  MARKETING
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// One row per dispatch attempt (success or failure), written before the provider
/// is called and updated with the outcome — this is what the admin delivery
/// dashboard (P76) reads. `recipient` is the delivery address; rendered content is
/// deliberately NOT stored, only `templateKey`.
model NotificationLog {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String?             @db.Uuid
  channel      NotificationChannel
  provider     String
  recipient    String
  templateKey  String
  subject      String?
  status       NotificationStatus  @default(PENDING)
  errorMessage String?
  metadata     Json?
  createdAt    DateTime            @default(now())
  sentAt       DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, channel, createdAt])
  @@index([status, createdAt])
  @@index([templateKey, status])
}

/// Per-user channel × category opt-in, seeded with defaults at user creation.
/// A missing row is treated as enabled; security notices ignore this table.
model NotificationPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  channel   NotificationChannel
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@index([userId])
}

/// The in-app notification inbox (NOT-02) — the Notification Center's rows.
///
/// Distinct from NotificationLog on purpose: a log row is one DELIVERY ATTEMPT on
/// one channel (audit; deliberately stores no rendered content), whereas this is
/// the message the user actually reads and marks as read. Written by the IN_APP
/// provider through the same dispatcher as every other channel, so a notification
/// can never reach the inbox without honouring preferences.
///
/// Content IS stored here — unlike the log — because the inbox has to render
/// without re-running a template months later, and the deep link has to survive.
model Notification {
  id       String               @id @default(uuid()) @db.Uuid
  userId   String               @db.Uuid
  category NotificationCategory

  /// The template this was rendered from; the join back to the delivery trail.
  templateKey String
  title       String
  body        String

  /// Where clicking it goes (NOT-02 deep-link). App-relative, never absolute, so
  /// it stays correct across environments and cannot be turned into an open
  /// redirect by a template variable.
  url String?

  /// Drives the "Important" filter. Set from the template's category — money,
  /// safety, disputes and security matter at a glance; marketing does not.
  important Boolean @default(false)

  /// Which role this notification is ABOUT, when the emitting listener knows
  /// (a worker invitation is inherently WORKER-relevant). Null for identity-level
  /// notices (security, verification, trust) that are the same regardless of the
  /// viewer's active role. Lets the client auto-switch active role before
  /// navigating, so a Worker-side notice opened while the session is in Client
  /// mode still lands the viewer where the content actually makes sense.
  relevantRole Role?

  /// The sound to play when this notification arrives while the app is open in a
  /// tab (see notification-sound.ts). Resolved once at write time from the
  /// recipient's per-category preference, or the category's default. Background
  /// push notifications ignore this — no current browser lets a site choose the
  /// OS notification sound, so those always play the device default.
  soundKey String?

  readAt DateTime?

  /// Ids the surface needs to render context (jobId, disputeId…). Never secrets.
  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The centre's default list, newest first.
  @@index([userId, createdAt])
  /// The Unread filter and the header badge count.
  @@index([userId, readAt])
  /// The Important filter.
  @@index([userId, important, createdAt])
}

/// Per-user, per-category notification sound override (see notification-sound.ts
/// for the fixed key set). A missing row means "use the category's default
/// sound" — the same opt-out shape as NotificationPreference, so a user who has
/// never touched sound settings still gets sensible per-category sounds.
model NotificationSoundPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  soundKey  String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trust Engine (SRS §6 TRU-*, §21.4 tiers, §21.5 point model, §21.6 pillars).
//
// The moat. Everything here hangs off the IDENTITY (User), never off a role, so
// a Worker who starts hiring keeps every check they have already passed.
//
// Shape of the system:
//   TrustEvent          append-only log — the only source of truth for the score
//   TrustScore          a derived SNAPSHOT of that log, safe to delete and rebuild
//   VerificationRecord  the state of each progressive check (TRU-06)
//   Document            the KYC/portfolio artefacts a check is decided on (TRU-08)
//   Endorsement         community credibility, capped + tapering (§21.6, FR-35)
//   TierConfig          the admin-tunable gates tier derivation reads (§21.4)
// ─────────────────────────────────────────────────────────────────────────────

/// The four trust pillars (SRS §21.6). Every scoring rule belongs to exactly one,
/// which is what makes the TRU-04 breakdown screen explainable rather than a
/// single opaque number.
enum TrustPillar {
  IDENTITY
  PROFESSIONAL
  MARKETPLACE
  FINANCIAL
}

/// Every scorable thing that can happen to an identity (SRS §21.5).
///
/// This enum is deliberately closed: a new way to earn or lose trust is a schema
/// change plus a rule in the point model, reviewed together — never an ad-hoc
/// delta written by whichever module happened to be running.
enum TrustEventType {
  /// Baseline granted once at sign-up (§21.5 "Starting score", +15).
  ACCOUNT_CREATED
  PHONE_VERIFIED
  ID_VERIFIED
  FIELD_VERIFIED
  PORTFOLIO_ADDED
  JOB_COMPLETED
  REPEAT_CUSTOMER
  EXCELLENT_REVIEW
  DISPUTE_UPHELD
  JOB_CANCELLED
  /// Confirmed fraudulent documents. Permanent suspension, overriding whatever
  /// score was accumulated (TRU-08, §21.5 last row).
  FAKE_DOCUMENTS_CONFIRMED
  /// Community endorsement (§21.6, FR-35): a small capped contribution that
  /// tapers away as verified job history accumulates.
  ENDORSEMENT_RECEIVED
  /// Cancels one ENDORSEMENT_RECEIVED (author retracted, moderation reversed).
  ///
  /// The ledger is append-only, so influence is withdrawn by appending its
  /// negation rather than deleting the original — the history still shows that
  /// the endorsement was given and then taken back, which is the honest record.
  ENDORSEMENT_REVOKED
  /// Cancels one EXCELLENT_REVIEW when moderation hides the review behind it
  /// (PROMPT 79, REV-03). Same discipline as ENDORSEMENT_REVOKED, and the reason
  /// the REVOCATION rule kind was written as a general shape rather than an
  /// endorsement special case: a review taken down must stop paying points, but
  /// deleting the original ledger row would erase that it was ever counted.
  EXCELLENT_REVIEW_REVOKED
  /// An admin moving a score by hand in an exceptional case (ADM-04, FR-42).
  ///
  /// The ONLY event whose magnitude is not fixed by the point model: the amount
  /// is carried on the ledger row's own `delta` and replayed from there, so an
  /// adjustment is still a recorded fact the score is derived FROM rather than an
  /// edit applied TO it (SRS §21: "the total is recomputed, never edited
  /// directly"). Bounded per event and audit-logged with the acting admin.
  ADMIN_ADJUSTMENT
  /// A dispute the CLIENT raised and lost (ADM-05, PROMPT 85 follow-up).
  ///
  /// Separate from DISPUTE_UPHELD, and lighter (−10 against −20), because the two
  /// failures are not equally grave. A worker who took payment and did not
  /// deliver broke the core bargain; a client whose complaint did not hold up
  /// froze someone's payout and cost them time. Both are real, only one is a
  /// breach of the work itself — and pricing them the same would either
  /// under-punish non-delivery or teach clients never to raise a dispute.
  DISPUTE_LOST
}

/// An append-only entry in the trust ledger. Rows are NEVER updated or deleted —
/// a correction is a new compensating event, so the history stays auditable.
///
/// `delta` is the NOMINAL per-occurrence impact recorded at emit time, kept for
/// the audit trail and the "what changed" UI. It is not what the score is
/// computed from: recomputation replays this log through the point model so caps,
/// tapers and clamping are applied consistently (see trust-score.model.ts).
model TrustEvent {
  id         String         @id @default(uuid()) @db.Uuid
  subjectId  String         @db.Uuid
  type       TrustEventType
  pillar     TrustPillar
  delta      Int
  /// Who caused it (admin approving an ID, a client completing a job). Null for
  /// system-generated events such as ACCOUNT_CREATED.
  actorId    String?        @db.Uuid
  /// What the event points back at — "Job", "Review", "VerificationRecord" — so
  /// the breakdown can link a point change to the thing that caused it.
  sourceType String?
  sourceId   String?
  metadata   Json?
  occurredAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  subject User  @relation("TrustEventSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  actor   User? @relation("TrustEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// The replay path: every recompute reads one subject's log in order.
  @@index([subjectId, occurredAt])
  /// Milestone lookups ("has this identity ever been ID_VERIFIED?").
  @@index([subjectId, type])
  @@index([actorId, createdAt])
}

/// A derived snapshot of the trust ledger: the four sub-scores plus the total.
///
/// Purely a read cache — dropping this table and replaying TrustEvent rebuilds it
/// exactly. That is why the score can be re-derived after a scoring-rule change
/// without any data migration.
model TrustScore {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @unique @db.Uuid

  identityScore     Int @default(0)
  professionalScore Int @default(0)
  marketplaceScore  Int @default(0)
  financialScore    Int @default(0)
  /// Clamped to [0, 100]. Zero and meaningless while `suspended` is true.
  total             Int @default(0)

  /// Confirmed fraudulent documents override the numeric score entirely
  /// (TRU-08). Kept here so the override travels with the score it replaces.
  suspended        Boolean   @default(false)
  suspendedAt      DateTime?
  suspensionReason String?

  /// Denormalised tier-gate inputs (§21.4). `completedJobs` is derived from the
  /// ledger on every recompute; `averageRating` is fed by the reviews module and
  /// stays null until an identity has been rated, which leaves the Tier 3 rating
  /// gate correctly unmet rather than accidentally satisfied by a zero.
  completedJobs Int      @default(0)
  averageRating Decimal? @db.Decimal(3, 2)

  /// How many ledger rows this snapshot covers — makes a stale snapshot obvious.
  eventCount Int      @default(0)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subject User @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Default search ranking orders on the total (DIS-08, TRU-04); descending
  /// scans of this index are what Phase 3 discovery sorts on.
  @@index([total])
  @@index([suspended])
}

/// The progressive checks behind the tiers (TRU-06, §21.4).
enum VerificationCheckType {
  PHONE
  ID_SUBMITTED
  ID_APPROVED
  SELFIE_LIVENESS
  ADDRESS
  PORTFOLIO
  FIELD_VERIFICATION
  BUSINESS_REGISTRATION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// The review pipeline a submission walks (AGT-03, ADM-03).
///
/// Separate from `status` on purpose: `status` is the OUTCOME the Trust Engine
/// and the tier gates read (three values, stable forever), while `stage` is the
/// operational position in the queue that agents and admins work. Collapsing
/// them would either hide the queue from operations or leak workflow churn into
/// the scoring contract.
enum VerificationStage {
  SUBMITTED
  UNDER_REVIEW
  FIELD_CHECK
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Why a submission was turned down. A CODE rather than free text because the
/// friendly-retry copy (TRU-07) is localized EN/FR in the web catalogue and must
/// never be an English sentence typed by a reviewer into a database column.
///
/// Reviewers can still add specifics in `reason`; the code decides the tone, the
/// retry affordance, and — for CONFIRMED_FRAUDULENT — the suspension.
enum VerificationRejectionReason {
  /// Automated OCR could not read the document. "Try again in better lighting."
  OCR_UNREADABLE
  DOCUMENT_EXPIRED
  /// Name/date of birth on the document disagrees with the account.
  DETAILS_MISMATCH
  INCOMPLETE_SUBMISSION
  WRONG_DOCUMENT_TYPE
  FIELD_CHECK_FAILED
  /// Escalated for investigation. Rejects the attempt; does NOT suspend.
  SUSPECTED_FRAUD
  /// Confirmed forgery. Permanent suspension, overriding the score (TRU-08).
  CONFIRMED_FRAUDULENT
  OTHER
}

/// One attempt at one check. Rows are NOT unique per (subject, checkType): a
/// rejection must be re-submittable (TRU-06 "re-upload on rejection"), so each
/// attempt is its own row and the LATEST row per check type is the live state.
model VerificationRecord {
  id        String                @id @default(uuid()) @db.Uuid
  subjectId String                @db.Uuid
  checkType VerificationCheckType
  status    VerificationStatus    @default(PENDING)
  stage     VerificationStage     @default(SUBMITTED)

  /// Which re-submission this is, 1-based. Kept denormalised so the friendly
  /// retry can soften ("still not quite readable") without counting rows.
  attempt Int @default(1)

  /// Agent/admin currently holding the item, so two reviewers do not both work
  /// the same submission. Cleared when the item leaves their hands.
  assignedToId String? @db.Uuid
  /// Admin or Field Agent who decided it (ADM-03, TRU-09).
  reviewerId   String? @db.Uuid

  /// The coded outcome the localized retry copy is keyed on (TRU-07).
  rejectionReason VerificationRejectionReason?
  /// Reviewer's free-text detail. Shown to staff; NEVER rendered to the subject
  /// as-is — it is neither localized nor guaranteed to be kind.
  reason          String?
  /// What was asked for when a reviewer chose "request more info" (AGT-03).
  infoRequest     String?
  infoRequestedAt DateTime?

  /// Free-form check evidence (OCR confidence, GPS fix of a field visit).
  metadata Json?

  submittedAt    DateTime  @default(now())
  stageUpdatedAt DateTime  @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subject    User  @relation("VerificationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reviewer   User? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("VerificationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  documents   VerificationDocument[]
  stageEvents VerificationStageEvent[]

  /// "Latest attempt per check type for this subject" — the tier-gate read path.
  @@index([subjectId, checkType, createdAt])
  /// The admin review queue.
  @@index([status, createdAt])
  /// The pipeline board, one column per stage (AGT-03).
  @@index([stage, submittedAt])
  /// "What is on my desk right now" for one agent.
  @@index([assignedToId, stage])
}

/// The evidence a check was decided on (TRU-06, TRU-08).
///
/// A join rather than a foreign key on either side, because the relationship is
/// genuinely many-to-many in both directions: an ID check needs front AND back,
/// and one selfie can back both a liveness check and a field visit.
model VerificationDocument {
  id                   String @id @default(uuid()) @db.Uuid
  verificationRecordId String @db.Uuid
  mediaAssetId         String @db.Uuid

  createdAt DateTime @default(now())

  verificationRecord VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)
  mediaAsset         MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([verificationRecordId, mediaAssetId])
  /// "What is the review status of this document?" — the Documents area (TRU-08).
  @@index([mediaAssetId])
}

/// Every move a submission makes through the pipeline (AGT-03, NFR-SEC-05).
///
/// Append-only. This is what the per-stage counts, the average review time and
/// the approval rate are computed from — deriving them from the record's current
/// stage alone would make "how long does review take" unanswerable the moment an
/// item moves twice.
model VerificationStageEvent {
  id                   String             @id @default(uuid()) @db.Uuid
  verificationRecordId String             @db.Uuid
  /// Null for the row written when the submission first enters the pipeline.
  fromStage            VerificationStage?
  toStage              VerificationStage

  /// Null for system transitions (automated OCR moving an item on).
  actorId   String? @db.Uuid
  note      String?
  /// Ties the transition to the request that caused it, per the error contract.
  requestId String?

  createdAt DateTime @default(now())

  verificationRecord VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)
  actor              User?              @relation("VerificationStageActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([verificationRecordId, createdAt])
  /// Throughput metrics per stage over a date window.
  @@index([toStage, createdAt])
}

/// How the endorser knows the person (§21.6). A closed list keeps the weighting
/// reviewable and stops "endorsed by a friend" from reading like a credential.
enum EndorsementRelationship {
  PREVIOUS_CUSTOMER
  WORKSHOP_OWNER
  QUARTER_CHIEF
  LANDLORD
  COMMUNITY_LEADER
  COLLEAGUE
}

enum EndorsementStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A community endorsement (FR-35). Only APPROVED rows emit a trust event, and
/// their combined contribution is capped and tapers as real job history lands —
/// early credibility without diluting earned reputation.
model Endorsement {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid

  /// Set when the endorser has an account; otherwise `authorName` carries an
  /// off-platform endorser captured by a Field Agent.
  authorId     String?                 @db.Uuid
  authorName   String?
  relationship EndorsementRelationship
  quote        String
  /// 1–5 stars, validated in the DTO before it reaches here.
  rating       Int
  status       EndorsementStatus       @default(PENDING)

  /// Staff who approved, rejected or captured it. An off-platform endorsement
  /// has no accountable author, so the agent who collected it stands behind it.
  reviewedById String?   @db.Uuid
  reviewedAt   DateTime?
  /// Why it was turned down. Staff-facing; never rendered to the endorser.
  reviewNote   String?
  /// Withdrawn after approval (author retracted, moderation reversed). The trust
  /// ledger is append-only, so revocation is a compensating ENDORSEMENT_REVOKED
  /// event rather than a deletion — this column is just the current fact.
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject    User  @relation("EndorsementSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  author     User? @relation("EndorsementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("EndorsementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// One endorsement per author per subject. NULL author ids repeat freely under
  /// Postgres NULL semantics, which is exactly right: off-platform endorsements
  /// are vouched for by the capturing agent, not deduplicated by identity.
  @@unique([subjectId, authorId])
  @@index([subjectId, status, createdAt])
  @@index([authorId])
  /// The staff moderation queue.
  @@index([status, createdAt])
}

/// Milestone badges (TRU-11). Awarded by rule from trust events, never granted
/// by hand — the same discipline as tiers, for the same reason: a badge that can
/// be given as a favour is not evidence of anything.
enum BadgeType {
  /// Recruited and verified in person by a Field Agent (TRU-09, AGT-01).
  FOUNDING_PROFESSIONAL
  /// National ID approved by staff.
  IDENTITY_VERIFIED
  /// Reached Tier 2.
  VERIFIED_PROFESSIONAL
  /// Reached Tier 3.
  FIELD_VERIFIED_PROFESSIONAL
  /// Trust Score thresholds, mirroring TRUST_SCORE_THRESHOLDS in the point model.
  TRUST_SCORE_25
  TRUST_SCORE_50
  TRUST_SCORE_75
  TRUST_SCORE_90
  /// Completed-job milestones.
  FIRST_JOB
  JOBS_10
  JOBS_25
  JOBS_50
  JOBS_100
  /// Five approved community endorsements (TRU-10).
  COMMUNITY_ENDORSED
  /// RCCM registration approved by staff (BIZ-01). Awarded to the OWNER identity,
  /// like every other badge — the badge registry is keyed on a user, and the
  /// company's standing travels with the person accountable for it.
  VERIFIED_BUSINESS
}

/// One unlocked badge (TRU-11). Milestones are PERMANENT: a Trust Score that
/// later dips does not un-ring the bell, because the badge records that the
/// thing happened, not that it is still true. Tier badges and the tier itself
/// are separate for exactly this reason — the tier demotes, the badge remembers.
model UserBadge {
  id        String    @id @default(uuid()) @db.Uuid
  subjectId String    @db.Uuid
  type      BadgeType

  /// What unlocked it — "TierChange", "TrustEvent", "FoundingIntake".
  sourceType String?
  sourceId   String?
  metadata   Json?

  awardedAt DateTime @default(now())

  subject User @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// A badge unlocks once. The unique constraint is the idempotency guarantee:
  /// a replayed event cannot double-award or re-notify.
  @@unique([subjectId, type])
  /// The trust-history timeline, newest first.
  @@index([subjectId, awardedAt])
}

/// The tier gates (§21.4), as DATA rather than literals in code.
///
/// "Thresholds are Admin-configurable" is a hard requirement, so the derivation
/// service reads every number from this table. One row per tier; the seeded rows
/// reproduce the SRS table exactly, and moving a number here moves the boundary
/// for everyone on the next recompute.
model TierConfig {
  id   String           @id @default(uuid()) @db.Uuid
  tier VerificationTier @unique

  /// Minimum Trust Score for the tier. Gates are AND-ed with the checks below.
  minScore         Int                     @default(0)
  /// Checks that must be VERIFIED. Cumulative in effect: derivation walks the
  /// tiers in order and stops at the first unmet gate, so a tier can never be
  /// skipped even if a later tier's own list happens to be satisfied.
  requiredChecks   VerificationCheckType[]
  /// Tier 3 volume/quality gates. Null means "not gated on this".
  minCompletedJobs Int?
  minAverageRating Decimal?                @db.Decimal(3, 2)

  /// Stable key for the EN/FR label + unlock copy in the web message catalogue.
  labelKey String

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Onboarding & profiles (ACC-10, TRU-05, BIZ-04 intake). PROMPTS 20, 21, 22.
//
// Onboarding is autosaved step-by-step and resumable, so the in-progress answers
// live in OnboardingProgress.data as JSON while the user is still filling them
// in. Only on completion are they materialised into the typed profile models
// below — a half-finished WorkerProfile would otherwise be indistinguishable
// from a real one to search and the Trust Engine.
// ─────────────────────────────────────────────────────────────────────────────

/// The roles that have an onboarding flow. AGENT/ADMIN are staff, onboarded by
/// TrustPro rather than self-service.
enum OnboardingRole {
  WORKER
  CLIENT
  BUSINESS
}

/// Where a stored location came from. A human-placed pin ALWAYS wins over an
/// auto-detected fix (CLAUDE.md SPATIAL), so the provenance has to be stored
/// alongside the coordinates rather than inferred later.
enum LocationSource {
  DEVICE_GPS
  HUMAN_INPUT
  REVERSE_GEOCODE
}

/// Autosave + resume state for one identity's onboarding in one role (ACC-10).
///
/// `data` is the partially-filled form. It is deliberately schemaless: the step
/// shapes are still moving, and a migration per field change would be friction
/// with no safety payoff while the answers are not yet authoritative.
///
/// `completionPercent` is DERIVED server-side from `data` on every write, never
/// sent by the client — it drives the unlockable-benefit messaging (TRU-05) and
/// a client-supplied value would let anyone claim a complete profile.
model OnboardingProgress {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @db.Uuid
  role   OnboardingRole

  currentStep       String
  data              Json      @default("{}")
  completionPercent Int       @default(0)
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One flow per identity per role — the resume lookup.
  @@unique([userId, role])
  @@index([userId])
}

/// A worker's public-facing profile (ACC-10). Tier and Trust Score are NOT here:
/// they belong to the identity on User, so a role switch never re-verifies.
model WorkerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  headline        String?
  bio             String?
  yearsExperience Int?

  /// Coarse location for discovery. The authoritative PostGIS geography column
  /// and its GIST index arrive with the spatial schema (PROMPT 38); these plain
  /// columns are what onboarding captures and are safe to backfill from.
  city           String?
  area           String?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource?

  /// Free-text landmark the worker typed ("behind Total Bonapriso"). Human input
  /// is the most reliable address format in Douala and Yaoundé, so it is stored
  /// verbatim next to the coordinates rather than being parsed into them.
  landmark          String?
  locationUpdatedAt DateTime?

  /// The administrative area the coordinates fall in, resolved server-side
  /// (PROMPT 39). Denormalised so a region filter is an equality test rather
  /// than a polygon containment check on every discovery query.
  geoRegionId String? @db.Uuid

  /// Profile cover image (PRO-01). The avatar lives on User, because it is the
  /// identity's face across every role; the cover is Worker-profile decoration
  /// and belongs here.
  coverAssetId String? @db.Uuid

  /// Authoritative spatial position (PROMPT 38, SRS §12). Maintained from
  /// latitude/longitude by the `trustpro_sync_location` trigger and indexed
  /// GIST — all distance and containment math runs against THIS column, never
  /// against the plain floats above, which exist only for display and capture.
  ///
  /// Deliberately `Unsupported`: Prisma has no geography type, and exposing it
  /// as a scalar would invite client-side spatial math the SRS forbids. Reads go
  /// through the reviewed `geo.*` views (PROMPT 40).
  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoRegion    GeoRegion?              @relation("WorkerProfileRegion", fields: [geoRegionId], references: [id], onDelete: SetNull)
  cover        MediaAsset?             @relation("WorkerProfileCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  services     Service[]
  availability Availability[]
  exceptions   AvailabilityException[]
  portfolio    PortfolioItem[]

  @@index([city])
  @@index([geoRegionId])
}

/// A client's profile (ACC-10) — deliberately minimal: hiring should not require
/// the same disclosure as offering work.
model ClientProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  displayName String?

  city           String?
  area           String?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource?

  landmark          String?
  locationUpdatedAt DateTime?
  geoRegionId       String?   @db.Uuid

  /// See WorkerProfile.location — same trigger, same GIST index, same rule.
  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoRegion GeoRegion? @relation("ClientProfileRegion", fields: [geoRegionId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([geoRegionId])
}

/// Business intake (BIZ-04). `verified` stays false here on purpose: approving a
/// business is a Trust/Admin decision (BIZ-01), never something the intake form
/// can grant itself.
model BusinessProfile {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @unique @db.Uuid

  name        String
  description String?
  /// Cameroon trade register number (RCCM). Verified in a later phase.
  rccmNumber  String?
  taxId       String?

  contactEmail String?
  contactPhone String?

  city           String?
  area           String?
  address        String?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource?

  /// Enhanced Business Verification (BIZ-01). Set ONLY by the RCCM approval
  /// listener when a BUSINESS_REGISTRATION check is approved — never by an owner
  /// edit — which is what makes the "Verified Business" badge mean something.
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  /// The staff member who approved the registration, for the audit trail.
  verifiedById String?   @db.Uuid

  /// Company logo (PRO-06). A MediaAsset FK rather than a URL column: the logo
  /// goes through the same upload validation, ownership and signed-access rules
  /// as every other file, and a raw URL column would be the one way to bypass
  /// them.
  logoAssetId String? @db.Uuid

  landmark          String?
  locationUpdatedAt DateTime?
  geoRegionId       String?   @db.Uuid

  /// See WorkerProfile.location — same trigger, same GIST index, same rule.
  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  geoRegion  GeoRegion?           @relation("BusinessProfileRegion", fields: [geoRegionId], references: [id], onDelete: SetNull)
  logo       MediaAsset?          @relation("BusinessProfileLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  verifiedBy User?                @relation("BusinessProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  team       BusinessTeamMember[]
  jobs       Job[]                @relation("JobBusiness")

  @@index([city])
  @@index([geoRegionId])
  /// The "verified businesses" browse and the corporate-eligibility check (BIZ-01).
  @@index([verified])
}

/// Team roles and access levels per BIZ-03. Captured at intake; full team
/// management (invitations, wallets, analytics) is a later Business phase.
enum TeamMemberRole {
  ADMIN
  HR_MANAGER
  ACCOUNTANT
  STAFF
}

enum TeamMemberAccessLevel {
  FULL
  MANAGE_JOBS
  PAYMENTS
  VIEW_ONLY
}

enum TeamMemberStatus {
  INVITED
  ACTIVE
  REMOVED
  /// The invitee said no. Distinct from REMOVED, which is the business's
  /// decision: conflating the two would misreport why a seat is empty.
  DECLINED
}

/// A member of a business's team (BIZ-03).
///
/// Identified by email/phone rather than a User FK AT INTAKE — the colleague
/// being invited usually has no TrustPro account yet — and bound to `userId` when
/// the invitation is accepted. Both facts are needed: the contact details are how
/// the invitation is delivered, and the identity is what server-side access
/// enforcement resolves against. An unaccepted row grants nothing.
model BusinessTeamMember {
  id                String @id @default(uuid()) @db.Uuid
  businessProfileId String @db.Uuid

  /// Bound on acceptance. NULL means "invited, not yet an identity" — and the
  /// access resolver treats a NULL userId as no access at all, so a pending
  /// invitation can never be a way in.
  userId String? @db.Uuid

  name        String
  email       String?
  phone       String?
  /// The member's job title inside the company. Free text: this is org chrome,
  /// not a permission — `accessLevel` is what the server enforces.
  title       String?
  role        TeamMemberRole        @default(STAFF)
  /// What this member may DO (BIZ-03). Enforced server-side on every business
  /// write via business-access.model.ts — never trusted from the client, and
  /// never inferred from `role`, which is an HR label.
  accessLevel TeamMemberAccessLevel @default(VIEW_ONLY)
  status      TeamMemberStatus      @default(INVITED)

  /// The owner/admin who sent the invitation, for the audit trail.
  invitedById String? @db.Uuid

  /// HMAC digest of the invitation token, never the token itself — the same
  /// discipline as RefreshToken. A leaked database must not hand out team seats.
  invitationTokenHash String?   @unique
  invitationSentAt    DateTime?
  /// Invitations lapse. An invite that is valid forever is a permanent
  /// unrevoked grant sitting in someone's inbox.
  invitationExpiresAt DateTime?
  acceptedAt          DateTime?
  removedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  user            User?           @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy       User?           @relation("TeamMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([businessProfileId, status])
  /// The access resolver's hot path: "what may this identity do for this
  /// business?" — one indexed lookup on every business-scoped write.
  @@index([userId, status])
  /// One live seat per identity per business, enforced by a partial unique index
  /// in the migration (WHERE "userId" IS NOT NULL AND status <> 'REMOVED'): a
  /// person can be re-invited after removal but never hold two seats at once.
  @@index([businessProfileId, userId])
}

/// A service a worker offers, with transparent starting price (PRO-05).
///
/// `categoryId` stays NULLABLE (PROMPT 37). Onboarding captures the worker's own
/// words first — intake is never blocked on a taxonomy entry that an admin has
/// not created yet — and the category is attached afterwards, by the worker or
/// by moderation. Search is scoped to the taxonomy (DIS-05), so an uncategorised
/// service is reachable by name but not by category browse, which is the correct
/// incentive: it costs the worker visibility without costing them the listing.
model Service {
  id              String  @id @default(uuid()) @db.Uuid
  workerProfileId String  @db.Uuid
  categoryId      String? @db.Uuid

  name          String
  description   String?
  /// XAF has no minor unit, so prices are whole-currency integers everywhere.
  startingPrice Int?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile WorkerProfile    @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([workerProfileId, isActive])
  /// Discovery by category (SRS §11.1) — the browse-a-category read path.
  @@index([categoryId, isActive])
}

/// The admin-managed service taxonomy search and job posting are scoped to
/// (ADM-02, DIS-05). CRUD arrives in PROMPT 43; the shape lands here.
///
/// Names are STORED bilingually rather than resolved through the web message
/// catalogue like the rest of the UI copy: this is admin-authored content that
/// changes without a deploy, so an EN/FR pair in the row is the only way both
/// locales can stay correct. Everything that is developer-authored copy stays in
/// next-intl.
model ServiceCategory {
  id   String @id @default(uuid()) @db.Uuid
  /// Stable, URL-safe key. Search filters and job posts reference the slug, so
  /// renaming a category in either language never breaks a saved filter.
  slug String @unique

  nameEn        String
  nameFr        String
  descriptionEn String?
  descriptionFr String?
  /// Icon identifier from the web icon set (e.g. "wrench"), never a URL.
  icon          String?

  /// Two-level taxonomy: a top-level trade with optional specialisations.
  parentId String? @db.Uuid

  sortOrder Int     @default(0)
  /// Retired rather than deleted (PROMPT 43): a category that has ever scoped a
  /// job or a service must keep resolving for that history to stay readable.
  isActive  Boolean @default(true)

  /// Denormalised count of workers offering at least one active service here.
  /// Recomputed by the taxonomy module, never incremented ad hoc — it drives
  /// "trending categories" (DIS-03) and the no-provider fallback copy (DIS-06),
  /// both of which are wrong in a way users notice if the number drifts.
  workerCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("ServiceCategoryTree")
  services Service[]
  jobs     Job[]

  /// The browse list: live categories in their admin-chosen order.
  @@index([isActive, sortOrder])
  @@index([parentId, sortOrder])
  /// Trending categories (DIS-03).
  @@index([workerCount])
}

/// A weekly availability slot. Times are local "HH:MM" strings rather than
/// DateTimes: this is a recurring weekly rule, not an instant, and storing it as
/// a timestamp would silently bind it to a date and a timezone.
model Availability {
  id              String @id @default(uuid()) @db.Uuid
  workerProfileId String @db.Uuid

  /// 0 = Sunday … 6 = Saturday, matching JavaScript's getDay().
  dayOfWeek Int
  startTime String
  endTime   String

  createdAt DateTime @default(now())

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, dayOfWeek, startTime, endTime])
  @@index([workerProfileId, dayOfWeek])
}

/// A one-off override of the weekly rule (PRO-05 "exceptions"): a public holiday
/// off, or a Sunday worked specially.
///
/// A separate model rather than a JSON column on Availability, because an
/// exception overrides the WHOLE DAY, not one slot — attaching it to a single
/// slot would leave the other slots on that day still claiming to be open.
model AvailabilityException {
  id              String @id @default(uuid()) @db.Uuid
  workerProfileId String @db.Uuid

  /// The calendar day being overridden, in the worker's local date. Stored as
  /// DATE, not a timestamp: "closed on 20 May" is not an instant, and giving it
  /// a time would bind a public holiday to whatever timezone wrote the row.
  date DateTime @db.Date

  /// False = unavailable all day (the common case). True = available on a day
  /// the weekly rule says is closed, in which case the times below apply.
  isAvailable Boolean @default(false)
  startTime   String?
  endTime     String?

  /// Worker's own words, shown to clients ("Fête du Travail").
  note String?

  createdAt DateTime @default(now())

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  /// One override per worker per day — a second one would be ambiguous.
  @@unique([workerProfileId, date])
  /// The availability filter's read path: upcoming exceptions for one worker.
  @@index([workerProfileId, date])
}

enum PortfolioItemType {
  PHOTO
  VIDEO
  PROJECT
}

/// Which half of a before/after pair an item is (PRO-02).
///
/// Nullable on the item, because most portfolio photos are neither: a single
/// finished-work shot is the common case, and forcing every upload to declare a
/// side would make the pairing meaningless.
enum PortfolioSlot {
  BEFORE
  AFTER
}

/// Portfolio evidence (PRO-02, PRO-03) — a first-class trust signal, not
/// decoration: it is the top survey-validated driver of who gets hired.
model PortfolioItem {
  id              String @id @default(uuid()) @db.Uuid
  workerProfileId String @db.Uuid
  mediaAssetId    String @db.Uuid

  type         PortfolioItemType @default(PHOTO)
  caption      String?
  /// Groups before/after pairs and multi-shot projects together.
  groupKey     String?
  /// The project's name, repeated on every item in the group.
  ///
  /// Denormalised rather than normalised into a PortfolioGroup table, because a
  /// group is otherwise nothing but a title — a whole table and a join for one
  /// string. Drift is prevented at the only place that can cause it: the
  /// portfolio service rewrites the title across the WHOLE group in one
  /// transaction, so no call site can set it on a single item.
  projectTitle String?

  /// Before/after position within the group (PRO-02). Null for ordinary items.
  slot PortfolioSlot?

  /// Display order within the profile, then within a group. Client-visible
  /// ordering is an owner decision, not an accident of upload time.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, groupKey])
  /// The gallery read path: one worker's portfolio in display order (PRO-02).
  @@index([workerProfileId, sortOrder])
}

/// What an uploaded file is. Drives the access rules below.
///
/// New values are APPENDED, never reordered: Postgres `ALTER TYPE ... ADD VALUE`
/// only appends, so keeping this list in migration order is what stops the
/// schema and the database from drifting apart on the next deploy.
enum MediaAssetKind {
  PORTFOLIO_IMAGE
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  SELFIE
  BUSINESS_REGISTRATION
  BUSINESS_LOGO
  PROOF_OF_ADDRESS
  CERTIFICATE
  /// Worker profile cover image (PRO-01). Its own kind rather than reusing
  /// PORTFOLIO_IMAGE: portfolio media is evidence of work done and is counted
  /// as such by the Trust Engine, and a decorative banner must not inflate it.
  WORKER_COVER
  /// A photo attached to a posted job (JOB-02) — "here is the broken pipe".
  /// Uploaded by the CLIENT, so it must never be confused with PORTFOLIO_IMAGE,
  /// which is a worker's evidence of work done and earns trust points.
  JOB_PHOTO
  /// A file a worker attaches to a quote (QTE-01): a sketch, a parts list.
  QUOTE_ATTACHMENT
  /// Evidence attached to a dispute message (PAY-03, ADM-05): a photo of the
  /// finished work, a receipt. PRIVATE — seen only by the two parties and the
  /// admin resolving the case, never public the way a job photo is.
  DISPUTE_EVIDENCE
  /// An image shared inside a conversation (MSG-01, PROMPT 70). PRIVATE: a chat
  /// between two people is not public, and its media is served only to the
  /// participants through signed URLs.
  MESSAGE_IMAGE
  /// A voice note shared inside a conversation (MSG-01). PRIVATE, same rule as
  /// MESSAGE_IMAGE — audio evidence of a negotiation is between the parties.
  MESSAGE_VOICE
  /// A photo attached to a review (REV-01). PUBLIC, because a review without its
  /// evidence is just an opinion — but its own kind rather than PORTFOLIO_IMAGE:
  /// this is the CLIENT's photo of delivered work and must never be counted as
  /// the worker's own portfolio evidence by the Trust Engine.
  REVIEW_PHOTO
}

/// PRIVATE media is served only through short-lived signed URLs; PUBLIC media
/// (portfolio, logos) may be served directly.
enum MediaVisibility {
  PRIVATE
  PUBLIC
}

/// A file stored in S3 (CLAUDE.md STORAGE, TRU-08). Only the object key lives in
/// the database — bytes never do, and access is decided at read time rather than
/// baked into a URL that would then be forwardable forever.
///
/// THE single storage record. PROMPT 27 folded the parallel `Document` model
/// into this one: review state (status, reviewer, rejection reason) belongs to
/// the CHECK a file was submitted for, not to the file, so it lives on
/// VerificationRecord and reaches a document through VerificationDocument. One
/// upload can therefore back several checks and carry a different outcome in
/// each, which two duplicated storage tables could never express.
model MediaAsset {
  id      String         @id @default(uuid()) @db.Uuid
  ownerId String         @db.Uuid
  kind    MediaAssetKind

  /// Object key in the bucket. Never a public URL.
  s3Key      String          @unique
  mimeType   String
  sizeBytes  Int
  visibility MediaVisibility @default(PRIVATE)

  /// SHA-256 of the bytes as stored. Two jobs: it proves the object under review
  /// is the object that was uploaded, and it catches the same ID being submitted
  /// under two accounts — the cheapest fraud signal available at upload time.
  checksum String?

  /// Soft delete. A user may retire a document from their Documents area, but
  /// the bytes behind a check that is under review (or that has already granted
  /// a tier) must survive for the audit trail — so nothing here is ever hard
  /// deleted while a verification points at it.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  owner              User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  portfolio          PortfolioItem[]
  verifications      VerificationDocument[]
  workerCovers       WorkerProfile[]        @relation("WorkerProfileCover")
  businessLogos      BusinessProfile[]      @relation("BusinessProfileLogo")
  jobPhotos          JobPhoto[]
  quoteAttachments   QuoteAttachment[]
  disputeEvidence    DisputeAttachment[]
  messageAttachments MessageAttachment[]
  reviewPhotos       ReviewPhoto[]

  @@index([ownerId, kind, createdAt])
  /// The Documents area lists live files only (TRU-08).
  @@index([ownerId, deletedAt])
  /// Duplicate-document detection across accounts.
  @@index([checksum])
}

// ─────────────────────────────────────────────────────────────────────────────
// Spatial (SRS §12, PROMPT 38). Location is layered and each layer has one job:
//
//   OSM          structural reality, ingested into the `osm` schema
//   PostGIS      the warehouse AND the authoritative maths (this file's columns)
//   CARTO        dynamic spatial SQL + MVT tiles (PROMPT 41)
//   BigDataCloud fast administrative reverse-geocoding (PROMPT 39)
//   Mapbox       paint only — NEVER authoritative for a calculation
//   Human input  a dropped pin or a landmark ALWAYS overrides a machine fix
//
// Only what the application owns is modelled here. The OSM warehouse (`osm.*`)
// and the reviewed read views (`geo.*`) live in their own Postgres schemas,
// created by raw SQL migrations: they are not Prisma's to manage, and keeping
// them out of `public` is what stops Prisma drift detection from proposing to
// drop a table it has no way to describe.
// ─────────────────────────────────────────────────────────────────────────────

/// Administrative depth of a region. Cameroon's hierarchy in the two launch
/// cities is Country → Region → City (commune) → District (arrondissement) →
/// Neighbourhood (quartier); the last is the level people actually use to say
/// where they are, which is why it is modelled rather than approximated.
enum GeoRegionLevel {
  COUNTRY
  REGION
  CITY
  DISTRICT
  NEIGHBOURHOOD
}

/// A named administrative area with a real boundary (SRS §12).
///
/// Seeded with the launch geography and then UPGRADED in place by the OSM
/// ingest: the seed carries approximate boundaries so the platform works on a
/// laptop with no network, and `osmId` is how the ingest finds the same row
/// again to replace that approximation with the real polygon. Seeding fake
/// precision and never correcting it is the failure mode this avoids.
model GeoRegion {
  id   String @id @default(uuid()) @db.Uuid
  /// Stable key ("douala-akwa"). Saved searches and shared links use this, so a
  /// renamed quarter does not break a URL someone sent on WhatsApp.
  slug String @unique

  nameEn String
  nameFr String
  level  GeoRegionLevel

  parentId String? @db.Uuid

  /// The OSM relation/way this boundary came from. Null while the row still
  /// holds its seeded approximation — which is exactly the "not yet ingested"
  /// signal the ingest script filters on.
  osmId BigInt?

  /// Authoritative boundary and centroid, GIST-indexed in the raw SQL migration.
  /// `Unsupported` on purpose: see WorkerProfile.location.
  boundary Unsupported("geography(MultiPolygon, 4326)")?
  center   Unsupported("geography(Point, 4326)")?

  /// Cached ST_Area of the boundary. Ranking a "within region" result set by
  /// specificity should not re-measure a polygon on every request.
  areaSqKm Float?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   GeoRegion?  @relation("GeoRegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children GeoRegion[] @relation("GeoRegionTree")

  workerProfiles   WorkerProfile[]   @relation("WorkerProfileRegion")
  clientProfiles   ClientProfile[]   @relation("ClientProfileRegion")
  businessProfiles BusinessProfile[] @relation("BusinessProfileRegion")
  jobs             Job[]             @relation("JobRegion")

  /// The region picker: live regions at one level.
  @@index([level, isActive])
  @@index([parentId])
  /// The ingest's "find the row this OSM relation already seeded" lookup.
  @@index([osmId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Jobs & Applications (PROMPTS 54-55, 57; SRS §6 JOB-*, §21.3 lifecycle).
//
// A job is the unit of work a Client posts and a Worker competes for. Three
// things about this area are load-bearing and easy to get wrong:
//
//   1. POSTING IS TIER-GATED (JOB-01). Nothing in this schema enforces that —
//      a tier lives on the identity and the gate is a server-side check in
//      JobPostingGateService. What the schema DOES do is keep `posterId` an
//      identity FK, so the gate has exactly one thing to evaluate whether the
//      poster is an individual or a business owner.
//
//   2. THE LIFECYCLE IS A STATE MACHINE, not a mutable label. `status` is only
//      ever moved through job-lifecycle.model.ts, and every move appends a
//      JobStatusEvent — which is what makes the status timeline (JOB-06) and
//      "how long do jobs sit unquoted" answerable at all.
//
//   3. LOCATION FOLLOWS THE PROFILE RULES. Same plain lat/lng columns, same
//      `trustpro_sync_location` trigger, same GIST-indexed geography column,
//      same "a human pin always overrides an auto-detected fix" provenance.
//      Proximity search over jobs must run on the same authoritative geometry
//      as proximity search over workers, or the two disagree about the city.
// ─────────────────────────────────────────────────────────────────────────────

/// The job lifecycle, exactly as tabulated in SRS §21.3.
///
/// REFUNDED is in the list even though PROMPT 55's summary omits it: the §21.3
/// state table gives Accepted → Refunded and Disputed → Refunded as real exits,
/// and a money state the enum cannot express is a state the escrow module would
/// have to invent a second time in Phase 5.
/// Who a published job is visible to (JOB-01).
///
/// The two are different products sharing one lifecycle. DIRECT is a private
/// engagement a client opens with a worker they already chose — it never
/// appears on the job board, so it carries no lure risk and needs no
/// verification or fee. PUBLIC is a broadcast vacancy on the board, which is
/// exactly the surface a fake-job lure abuses, so it is gated on a verified
/// business and carries the posting fee.
enum JobVisibility {
  DIRECT
  PUBLIC
}

enum JobStatus {
  DRAFT
  OPEN
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  RELEASED
  DISPUTED
  CANCELLED
  REFUNDED
  ARCHIVED
}

/// How soon the client needs the work (JOB-02).
///
/// A closed list rather than a free-text "when do you need this", because it is
/// a filter and a ranking input for workers deciding what to bid on, and
/// "urgent!!" typed into a box is neither.
enum JobUrgency {
  FLEXIBLE
  WITHIN_WEEK
  WITHIN_48_HOURS
  EMERGENCY
}

/// Application tracking states (JOB-04), in the words the worker sees on screen.
///
/// WITHDRAWN is ours rather than the SRS's: a worker who has taken other work
/// needs a way out that is not "not selected", which would misreport the
/// poster's rejection rate and read as a judgement the poster never made.
enum JobApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  NOT_SELECTED
  HIRED
  WITHDRAWN
}

/// A direct invitation's state (JOB-03).
enum JobInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  /// Withdrawn by the poster before the worker answered.
  CANCELLED
}

/// A posted job (JOB-01, JOB-02).
model Job {
  id String @id @default(uuid()) @db.Uuid

  /// The IDENTITY that posted, never a role row. An individual Client and a
  /// Business owner post the same kind of job and pass the same tier gate.
  posterId String @db.Uuid

  /// The business this job was posted ON BEHALF OF (BIZ-02), when a business
  /// owner or a scoped team member posted it. NULL for an individual client.
  ///
  /// Kept ALONGSIDE `posterId` rather than replacing it: the poster is the
  /// accountable identity that passed the tier gate and receives the quotes,
  /// while this is the company the spend and the analytics belong to. A team
  /// member with MANAGE_JOBS posts as themselves for a company they do not own,
  /// and collapsing the two would lose whichever half of that is inconvenient.
  businessProfileId String? @db.Uuid

  /// Team/bulk posting (BIZ-02): how many workers are wanted and for how long.
  /// Both NULL on an ordinary single-worker job — a `teamSize` of 1 written
  /// everywhere would make "is this a team job?" a comparison instead of a fact.
  teamSize     Int?
  durationDays Int?

  /// Scoped to the admin taxonomy (JOB-02, ADM-02). Nullable ONLY so the stepper
  /// can autosave a draft before the category step is done — publish() refuses to
  /// take a job live without one, so no OPEN job is ever uncategorised. That is
  /// the opposite trade-off from Service.categoryId (permanently optional): a
  /// worker's own-words listing is still reachable by name, but a job nobody can
  /// find in a category browse just sits there, and the poster pays for that.
  categoryId String? @db.Uuid

  title       String
  description String

  /// Budget range in whole XAF (no minor unit). Both nullable: JOB-02 asks for
  /// an encouraged fixed price/range, not a required one, and a client who
  /// genuinely does not know what a repair costs should not be made to invent a
  /// number that then anchors every quote they receive.
  budgetMin Int?
  budgetMax Int?

  urgency JobUrgency @default(FLEXIBLE)
  status  JobStatus  @default(DRAFT)

  /// DIRECT by default: the safe thing to be is invisible. A job only reaches
  /// the public board when a verified business explicitly publishes it there.
  visibility JobVisibility @default(DIRECT)

  /// What publishing this job to the board actually cost, in whole XAF, frozen
  /// at publish time. Kept on the row rather than read from the live setting so
  /// that changing the fee never rewrites what past posters were charged.
  postingFeeXaf Int @default(0)

  /// See WorkerProfile's location block — identical rules, same trigger.
  city           String?
  area           String?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource?
  landmark       String?
  geoRegionId    String?         @db.Uuid

  location Unsupported("geography(Point, 4326)")?

  /// When the job first went OPEN. Distinct from createdAt, which is when the
  /// draft was started — the two can be days apart, and it is publication, not
  /// creation, that orders a job board.
  publishedAt     DateTime?
  statusUpdatedAt DateTime  @default(now())
  /// Set on any terminal transition, so "closed in the last 30 days" is one
  /// indexed range scan rather than a CASE over five timestamps.
  closedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poster    User             @relation("JobPoster", fields: [posterId], references: [id], onDelete: Cascade)
  /// Restrict, not SetNull: the taxonomy is retired rather than deleted (see
  /// ServiceCategory), so a delete here means something has gone wrong upstream
  /// and silently orphaning live jobs would hide it. Optional to match the
  /// nullable scalar — a draft may not have chosen a category yet.
  category  ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  geoRegion GeoRegion?       @relation("JobRegion", fields: [geoRegionId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: deleting a company profile must not silently delete
  /// the jobs it posted, the quotes on them or the money that moved.
  business  BusinessProfile? @relation("JobBusiness", fields: [businessProfileId], references: [id], onDelete: SetNull)

  photos        JobPhoto[]
  reviews       Review[]
  statusEvents  JobStatusEvent[]
  applications  JobApplication[]
  invitations   JobInvitation[]
  quotes        Quote[]
  bookings      Booking[]
  disputes      Dispute[]
  conversations Conversation[]
  sosAlerts     SOSAlert[]

  /// The public job board: open jobs, newest published first.
  @@index([status, publishedAt])
  /// "My jobs", the poster's own list including drafts (JOB-07).
  @@index([posterId, status, createdAt])
  /// Browse-a-category and the matched-jobs feed workers see (JOB-04).
  @@index([categoryId, status, publishedAt])
  /// Region-scoped boards. Equality on the denormalised region rather than a
  /// polygon containment test on every request.
  @@index([geoRegionId, status])
  /// The business dashboard's own board: one company's posts by state (BIZ-02).
  @@index([businessProfileId, status, createdAt])
}

/// A photo attached to a job post (JOB-02).
///
/// A MediaAsset FK rather than a URL column, for the reason spelled out on
/// BusinessProfile.logoAssetId: a URL column would be the one path into the
/// system that skips upload validation, ownership and signed access.
model JobPhoto {
  id           String @id @default(uuid()) @db.Uuid
  jobId        String @db.Uuid
  mediaAssetId String @db.Uuid

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  /// The same photo cannot be attached twice — the idempotency guarantee for a
  /// retried upload on a flaky connection.
  @@unique([jobId, mediaAssetId])
  @@index([jobId, sortOrder])
}

/// Every move the job made through the lifecycle (JOB-05, JOB-06, §21.3).
///
/// Append-only, and the reason the status timeline exists: a job's current
/// `status` alone cannot answer "when did work actually start", which is both
/// the client-facing timeline and the input to every completion-rate and
/// response-time signal the Trust Engine will want.
model JobStatusEvent {
  id    String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid

  /// Null for the row written when the job is created as a draft.
  fromStatus JobStatus?
  toStatus   JobStatus

  /// Null for system transitions (escrow release, automatic expiry).
  actorId   String? @db.Uuid
  note      String?
  /// Ties the transition to the request that caused it, per the error contract.
  requestId String?

  createdAt DateTime @default(now())

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User? @relation("JobStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// The timeline read path: one job's history in order (JOB-06).
  @@index([jobId, createdAt])
  /// Throughput metrics per state over a date window.
  @@index([toStatus, createdAt])
}

/// A worker's application to a job (JOB-04).
///
/// Deliberately NOT the same thing as a Quote. An application is "I am
/// interested and here is why me"; a quote is a priced, itemised, acceptable
/// offer that creates a booking. Collapsing them would either force a price out
/// of a worker who has not seen the site yet, or let an expression of interest
/// be accepted into a contract.
model JobApplication {
  id       String @id @default(uuid()) @db.Uuid
  jobId    String @db.Uuid
  /// The worker IDENTITY, not their WorkerProfile: trust, tier and history all
  /// attach to the identity, and the poster is deciding about a person.
  workerId String @db.Uuid

  status  JobApplicationStatus @default(SUBMITTED)
  message String

  statusUpdatedAt DateTime  @default(now())
  withdrawnAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker User    @relation("JobApplicationWorker", fields: [workerId], references: [id], onDelete: Cascade)
  quotes Quote[]

  /// One application per worker per job. A worker with second thoughts revises
  /// the one they have; re-applying to shout louder is not a feature.
  @@unique([jobId, workerId])
  /// The poster's applicant list (JOB-03).
  @@index([jobId, status, createdAt])
  /// The worker's "my applications" tracker (JOB-04).
  @@index([workerId, status, createdAt])
}

/// A poster inviting a specific worker to a job (JOB-03).
///
/// Separate from JobApplication because the direction of consent is opposite: an
/// application is a worker offering themselves, an invitation is a client asking.
/// Merging them would make "who approached whom" — exactly what a worker weighs
/// when deciding whether to bother quoting — unrecoverable.
model JobInvitation {
  id          String @id @default(uuid()) @db.Uuid
  jobId       String @db.Uuid
  workerId    String @db.Uuid
  invitedById String @db.Uuid

  status  JobInvitationStatus @default(PENDING)
  message String?

  /// Invitations go stale. An open-ended one leaves a worker's inbox full of
  /// jobs that were filled weeks ago.
  expiresAt   DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker    User @relation("JobInvitationWorker", fields: [workerId], references: [id], onDelete: Cascade)
  invitedBy User @relation("JobInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  /// One invitation per worker per job — re-inviting is nagging.
  @@unique([jobId, workerId])
  /// The worker's incoming Job Requests (JOB-04).
  @@index([workerId, status, createdAt])
  @@index([jobId, status])
  /// The lazy expiry sweep.
  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Quotes & Negotiation (PROMPT 59; QTE-01, QTE-03, QTE-04).
//
// A quote is the priced offer that becomes a contract. Two decisions carry the
// negotiation:
//
//   REVISIONS ARE NEW ROWS. A counter-offer never edits a quote in place —
//   `parentQuoteId` chains the new offer to the one it supersedes. A price the
//   client saw must stay retrievable exactly as they saw it, because that is
//   what a dispute is argued over.
//
//   THE CLIENT'S COUNTER-REQUEST IS NOT A QUOTE. QTE-02 lets a client REQUEST a
//   counter-offer, not author one, so it is fields on the quote being countered
//   rather than a row of its own — the worker still sets every price in this
//   system, which is the whole point of a quote.
// ─────────────────────────────────────────────────────────────────────────────

/// The six quote states named in QTE-03. Deliberately no SUPERSEDED value: a
/// revised quote is DECLINED with `supersededAt` set, so the state contract
/// stays exactly the SRS's while the UI can still label it "Revised" rather
/// than the misleading "Declined".
enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

/// The unit an estimate is expressed in (QTE-01).
///
/// A unit plus a number rather than a minutes integer: a mason says "three
/// days", and storing that as 4320 minutes renders back as false precision in
/// whichever language the reader picked.
enum QuoteDurationUnit {
  HOUR
  DAY
  WEEK
}

/// A worker's priced offer on a job (QTE-01, QTE-03).
model Quote {
  id       String @id @default(uuid()) @db.Uuid
  jobId    String @db.Uuid
  workerId String @db.Uuid

  /// The application this grew out of, when there was one. Null for a quote sent
  /// straight off an invitation.
  applicationId String? @db.Uuid
  /// The quote this one revises. The head of a chain has null here.
  parentQuoteId String? @db.Uuid

  /// Whole XAF. The number the escrow will hold if this is accepted.
  price         Int
  durationValue Int?
  durationUnit  QuoteDurationUnit?

  /// The itemised "what's included" (QTE-01). A string array rather than a table
  /// because a line item has no identity of its own — it is never referenced,
  /// reordered independently or priced separately; it is one field of the offer.
  includes String[]
  message  String?

  status QuoteStatus @default(DRAFT)

  sentAt       DateTime?
  /// Set the first time the client opens it — the "Viewed" chip in the worker's
  /// Sent inbox (QTE-04), and a real signal that silence means no rather than
  /// unseen.
  viewedAt     DateTime?
  respondedAt  DateTime?
  /// A quote is a price for today's materials, not a standing offer.
  expiresAt    DateTime?
  /// Set when a revision replaced this quote. See QuoteStatus.
  supersededAt DateTime?

  /// The client's counter-offer REQUEST (QTE-02). Overwritten by a second
  /// request rather than accumulated: only the latest ask is live, and a history
  /// of asks belongs to the message thread, not to the offer.
  counterRequestedAt DateTime?
  counterMessage     String?
  counterTargetPrice Int?

  /// Why the client said no. Worker- and staff-facing; a coded reason is not
  /// worth the schema here because nothing branches on it.
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker      User            @relation("QuoteWorker", fields: [workerId], references: [id], onDelete: Cascade)
  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  parent      Quote?          @relation("QuoteRevision", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  revisions   Quote[]         @relation("QuoteRevision")

  attachments QuoteAttachment[]
  booking     Booking?

  /// The client's Received inbox for one job (QTE-04).
  @@index([jobId, status, createdAt])
  /// The worker's Sent / Drafts inboxes (QTE-04).
  @@index([workerId, status, createdAt])
  /// The lazy expiry sweep.
  @@index([status, expiresAt])
  @@index([parentQuoteId])
}

/// A file attached to a quote (QTE-01): a sketch, a parts list, a spec photo.
model QuoteAttachment {
  id           String @id @default(uuid()) @db.Uuid
  quoteId      String @db.Uuid
  mediaAssetId String @db.Uuid

  createdAt DateTime @default(now())

  quote      Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([quoteId, mediaAssetId])
  @@index([quoteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bookings (PROMPT 60; QTE-04, PAY-01 init).
//
// A booking is the agreement itself: this worker, this client, this price. It is
// created the moment a quote is accepted and is what the escrow state machine
// (P62-P65) will hang money off.
//
// The money columns are SNAPSHOTS, not derivations. `platformFeeBps` records the
// fee rate that was shown to the client before they paid (~10%, SRS §21), and
// the two amounts are computed once from it. Recomputing a fee at payout time
// from whatever the current rate happens to be would silently re-price an
// agreement both parties already made — the one failure a marketplace never
// gets forgiven for.
// ─────────────────────────────────────────────────────────────────────────────

/// The escrow lifecycle a booking walks (SRS §21.2; CLAUDE.md PAYMENTS).
///
/// PROMPT 60 implements only the entry state: a booking is created
/// PENDING_PAYMENT and an escrow-initiation event is emitted. Every transition
/// past that belongs to the payments module, which is why they are modelled here
/// rather than invented there — the states a booking can reach must be one
/// closed list, not two that drift.
enum BookingStatus {
  /// Created, escrow initiation requested, money not yet held.
  PENDING_PAYMENT
  /// Campay confirmed collection; funds held.
  PAID
  /// Worker acknowledged the funded booking (SRS §15.1 "worker accepts booking").
  /// Added by PROMPT 64 so booking status mirrors the EscrowHold money machine
  /// one-for-one from PAID onward — see EscrowState.
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  /// Client confirmed; worker paid out minus the fee. Terminal.
  RELEASED
  CANCELLED
  REFUNDED
  DISPUTED
}

/// An accepted quote, as an agreement (QTE-03, PAY-01).
model Booking {
  id      String @id @default(uuid()) @db.Uuid
  jobId   String @db.Uuid
  quoteId String @db.Uuid

  /// Both identities are denormalised onto the booking rather than walked
  /// through job → poster and quote → worker on every read. This is the row
  /// money moves against; who is owed what must be readable without a join that
  /// a later edit to either parent could quietly change.
  workerId String @db.Uuid
  clientId String @db.Uuid

  /// Whole XAF. Currency is not a column — the platform is XAF-only by
  /// requirement, and a column that can only hold one value invites code that
  /// pretends it can hold two.
  agreedPrice        Int
  /// The fee rate in basis points, snapshotted at acceptance. 1000 = 10%.
  platformFeeBps     Int
  platformFeeAmount  Int
  /// agreedPrice - platformFeeAmount. Stored rather than derived so a rounding
  /// rule change can never retroactively alter what a worker was promised.
  workerPayoutAmount Int

  status BookingStatus @default(PENDING_PAYMENT)

  /// When the escrow flow was kicked off (PAY-01). Null means the initiation
  /// event has not been emitted yet — which, on a live row, is a bug worth
  /// finding rather than a state worth reaching.
  escrowInitiatedAt DateTime?
  statusUpdatedAt   DateTime  @default(now())
  completedAt       DateTime?
  releasedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job    Job   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  /// One booking per quote, enforced by the unique below rather than checked in
  /// code: a double-accept under a double-tap on a bad connection would
  /// otherwise create two agreements for one offer.
  quote  Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  worker User  @relation("BookingWorker", fields: [workerId], references: [id], onDelete: Restrict)
  client User  @relation("BookingClient", fields: [clientId], references: [id], onDelete: Restrict)

  statusEvents     BookingStatusEvent[]
  escrowHold       EscrowHold?
  transactions     Transaction[]
  disputes         Dispute[]
  sosAlerts        SOSAlert[]
  trackingSessions TrackingSession[]
  reviews          Review[]

  @@unique([quoteId])
  /// Both parties' booking lists.
  @@index([workerId, status, createdAt])
  @@index([clientId, status, createdAt])
  @@index([jobId])
  /// The reconciliation sweep against Campay webhooks.
  @@index([status, createdAt])
}

/// Every move a booking made through the escrow states. Append-only.
///
/// The money audit trail (CLAUDE.md: "audit-log every money/verification
/// event"). AuditLog carries the cross-cutting record; this carries the
/// per-booking one the two parties are entitled to see.
model BookingStatusEvent {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid

  fromStatus BookingStatus?
  toStatus   BookingStatus

  /// Null for transitions driven by a Campay webhook rather than by a person.
  actorId   String? @db.Uuid
  note      String?
  requestId String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("BookingStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments, Wallet & Escrow (PROMPTS 62-66, 68; SRS §15, §3.8 PAY-*).
//
// The rules money lives by here, each of them load-bearing:
//
//   1. XAF, WHOLE INTEGERS, EVERYWHERE. Cameroon's franc has no minor unit, so
//      every amount is an integer number of francs — never a float, never a
//      currency column that pretends the platform is multi-currency.
//
//   2. THE LEDGER IS THE TRUTH; THE BALANCE IS A CACHE. Every movement of money
//      appends a Transaction row. `Wallet.availableBalance` is a running total
//      the payments service keeps in step INSIDE the same database transaction
//      that writes the ledger row, and a CHECK forbids it going negative — but
//      it can always be rebuilt by replaying the ledger, which is what makes a
//      reconciliation after a Campay hiccup a recomputation rather than a guess.
//
//   3. ESCROW IS A STATE MACHINE, NOT A FLAG. An EscrowHold walks the SRS §15.1
//      states (Paid → Accepted → In Progress → Completed → Released, plus
//      Refunded and Disputed) and is moved ONLY through escrow-lifecycle.model.ts.
//      It is 1:1 with a Booking, and Booking.status mirrors it name-for-name from
//      PAID onward (that is what BookingStatus.ACCEPTED was added for), so the two
//      never disagree because one service writes both in one transaction.
//
//   4. IDEMPOTENCY IS KEYED ON THE EXTERNAL REF. Campay confirms collection and
//      payout by webhook; a webhook can arrive twice. `Transaction.campayReference`
//      is UNIQUE, so a replayed confirmation is a no-op at the database rather
//      than a double credit (PAY-06, NFR-AVAIL-02).
// ─────────────────────────────────────────────────────────────────────────────

/// The rails Campay exposes for collection and payout in XAF (PAY-04).
///
/// MTN and Orange Mobile Money are the two operators that matter at launch; card
/// and bank are declared so the schema does not have to change when Campay's
/// other rails are switched on.
enum PaymentMethodType {
  MTN_MOMO
  ORANGE_MONEY
  CARD
  BANK
}

/// A user's saved way to pay or be paid (PAY-04).
///
/// NOTHING sensitive is stored in the clear: a Mobile Money method keeps only the
/// E.164 phone the collection is charged to, and a card/bank method keeps only a
/// masked tail Campay returns — the PAN and full account number never touch this
/// database, which is what keeps card data out of PCI scope here.
model PaymentMethod {
  id     String            @id @default(uuid()) @db.Uuid
  userId String            @db.Uuid
  type   PaymentMethodType

  /// Human label the user sees ("MTN •••• 6789", "My Orange line").
  label         String
  /// E.164 phone for a Mobile Money method — the number Campay collects from and
  /// pays out to. Null for card/bank.
  phone         String?
  /// Last few digits of a card/bank account, for recognition only. Never the full
  /// number. Null for Mobile Money (the phone is the recogniser there).
  maskedAccount String?
  /// Campay's operator label when known ("MTN", "ORANGE"), so a collection can be
  /// routed without re-detecting it from the phone prefix on every payment.
  operator      String?

  /// Exactly one default per user, enforced by a partial unique index in the
  /// migration (WHERE "isDefault") rather than a plain unique, so a user can have
  /// many non-default methods but never two defaults.
  isDefault Boolean @default(false)
  /// Soft-removed rather than deleted: a Transaction points back at the method it
  /// used, and that history must keep resolving after the user removes the card.
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  /// The management list: a user's live methods.
  @@index([userId, isActive])
}

/// What a ledger row represents (PAY-05 "payments, holds/releases, refunds,
/// withdrawals, fees"). A closed list: a new kind of money movement is a schema
/// change reviewed with the code that creates it, never an ad-hoc string.
enum TransactionType {
  /// Money added to the wallet from a payment method (PAY-05 "Add Money").
  DEPOSIT
  /// A client's payment funding an escrow hold on a booking.
  PAYMENT
  /// The moment funds are locked into escrow on collection confirmation.
  ESCROW_HOLD
  /// Escrow released to the worker's wallet on client confirmation (minus fee).
  ESCROW_RELEASE
  /// The platform's service fee, taken at release.
  FEE
  /// Escrow returned to the client (cancel before work, or dispute for client).
  REFUND
  /// Money paid out of the wallet to a payment method (PAY-05 "Withdraw").
  WITHDRAWAL
}

/// Where a ledger row is in its life. Campay-backed rows start PENDING and settle
/// on the webhook; internal moves (hold, release, fee) are SUCCESS immediately.
enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  /// A settled row undone by a later correction (a reconciliation reversal).
  REVERSED
}

/// Money in or out from the WALLET OWNER's point of view — a display and filter
/// axis (PAY-05 "status chips"), derived from the type at creation so the history
/// can show a red/green arrow without re-deriving it per row.
enum TransactionDirection {
  CREDIT
  DEBIT
}

/// The append-only money ledger (PAY-05, PAY-06). One row per movement; rows are
/// never edited to a different amount — a correction is a new REVERSED/compensating
/// row, so the trail an auditor or a disputing client reads is complete.
model Transaction {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  type      TransactionType
  status    TransactionStatus    @default(PENDING)
  direction TransactionDirection

  /// Whole XAF, always positive. The direction says which way it moved.
  amount Int

  /// What the money was about, when it hangs off a booking's escrow.
  bookingId       String? @db.Uuid
  escrowHoldId    String? @db.Uuid
  /// The method a DEPOSIT/PAYMENT/WITHDRAWAL used. Null for internal moves
  /// (hold, release, fee) that never touch an external rail.
  paymentMethodId String? @db.Uuid

  /// Campay's transaction reference. UNIQUE and the idempotency key: a webhook
  /// that arrives twice updates the same row rather than crediting again (PAY-06).
  /// Null for internal moves that never call Campay.
  campayReference   String? @unique
  /// The reference WE generated and sent to Campay as external_reference, so a
  /// callback can be matched back even before Campay's own reference is known.
  externalReference String? @unique

  /// Plain-language failure, keyed for localized copy (PAY-06 "declined,
  /// insufficient funds, operator timeout"). Staff-readable code; the EN/FR
  /// sentence lives in the web catalogue.
  failureReason String?
  /// Short human description for the history row ("Escrow for: Fix kitchen sink").
  description   String?
  metadata      Json?

  createdAt DateTime  @default(now())
  /// When Campay confirmed it (or an internal move committed). Null while PENDING.
  settledAt DateTime?
  updatedAt DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  escrowHold    EscrowHold?    @relation(fields: [escrowHoldId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  /// The history read path: one user's ledger, newest first, filterable by type
  /// and status (PAY-05).
  @@index([userId, type, createdAt])
  @@index([userId, status, createdAt])
  @@index([bookingId])
  /// The reconciliation sweep: pending Campay-backed rows awaiting a webhook.
  @@index([status, createdAt])
}

/// The escrow money states (SRS §15.1). A tighter set than BookingStatus: a hold
/// only exists once money is actually collected, so there is no PENDING_PAYMENT or
/// CANCELLED here — those are booking states before any money is held.
enum EscrowState {
  /// Client funds collected by Campay and held by the platform.
  PAID
  /// Worker acknowledged the funded booking.
  ACCEPTED
  /// Work under way.
  IN_PROGRESS
  /// Worker marked the work done, awaiting client confirmation.
  COMPLETED
  /// Client confirmed; payout credited to the worker minus the fee. Terminal.
  RELEASED
  /// Returned to the client. Terminal.
  REFUNDED
  /// Frozen pending admin resolution (PAY-03).
  DISPUTED
}

/// The funds held against a booking (SRS entity EscrowHold; PAY-01, PAY-02).
///
/// Distinct from the Booking on purpose: a Booking is the AGREEMENT and exists the
/// moment a quote is accepted; an EscrowHold is the MONEY and comes into being only
/// when Campay confirms the client's collection. The gap between the two — a booking
/// that is PENDING_PAYMENT with no hold yet — is a real, legible state rather than a
/// null amount on the agreement.
///
/// The amounts are snapshotted from the booking (themselves snapshotted at
/// acceptance), so what is held, what the fee is and what the worker will receive
/// are fixed at collection time and a later fee-rate change cannot re-price them.
model EscrowHold {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @unique @db.Uuid

  /// Denormalised parties, like Booking: this is a money record and who is owed
  /// what must be readable without walking two joins that an edit could change.
  clientId String @db.Uuid
  workerId String @db.Uuid

  /// Whole XAF held = the agreed price. `feeAmount + payoutAmount = amount`,
  /// enforced by a CHECK in the migration.
  amount       Int
  feeAmount    Int
  payoutAmount Int

  state EscrowState @default(PAID)

  /// The Campay collection reference that funded the hold — the tie back to the
  /// money-in event for reconciliation.
  campayCollectionRef String?

  paidAt      DateTime  @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  releasedAt  DateTime?
  refundedAt  DateTime?
  disputedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  client       User                @relation("EscrowClient", fields: [clientId], references: [id], onDelete: Restrict)
  worker       User                @relation("EscrowWorker", fields: [workerId], references: [id], onDelete: Restrict)
  statusEvents EscrowStatusEvent[]
  transactions Transaction[]
  disputes     Dispute[]

  /// The wallet's "in-escrow" overview reads these by party + live state (PAY-05).
  @@index([clientId, state])
  @@index([workerId, state])
  @@index([state, updatedAt])
}

/// Every move an escrow hold made through the money states (PAY-03 "auditable,
/// tamper-evident trail"). Append-only — the money audit trail, per hold.
model EscrowStatusEvent {
  id           String @id @default(uuid()) @db.Uuid
  escrowHoldId String @db.Uuid

  fromState EscrowState?
  toState   EscrowState

  /// Null for transitions a Campay webhook drove rather than a person.
  actorId   String? @db.Uuid
  note      String?
  requestId String?

  createdAt DateTime @default(now())

  escrowHold EscrowHold @relation(fields: [escrowHoldId], references: [id], onDelete: Cascade)
  actor      User?      @relation("EscrowStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([escrowHoldId, createdAt])
}

/// A dispute's lifecycle (PAY-03, ADM-05). OPEN is raised by a party; ESCALATED is
/// an admin marking it for closer handling; RESOLVED is terminal with a resolution.
enum DisputeStatus {
  OPEN
  ESCALATED
  RESOLVED
}

/// How an admin resolved a dispute (ADM-05). Each action drives the escrow machine:
/// RELEASE_TO_WORKER releases, REFUND_TO_CLIENT refunds, REQUEST_INFO keeps it open
/// while asking for more, CLOSE_NO_ACTION resolves without moving money (e.g. the
/// parties settled between themselves).
enum DisputeResolution {
  RELEASE_TO_WORKER
  REFUND_TO_CLIENT
  REQUEST_INFO
  CLOSE_NO_ACTION
}

/// Which party the resolving admin found at fault (ADM-05, §21.5 "disputes −20").
///
/// A SEPARATE judgement from `resolution`, deliberately, because the direction the
/// money went does not settle who behaved badly. A client who legitimately
/// escalates and loses has done nothing wrong, and charging them a 20-point
/// penalty for it would teach both parties never to raise a dispute — which is
/// the one outcome an escrow product cannot afford, since the escrow is only
/// worth anything if people are willing to use the process that unlocks it. So
/// the admin, who is the only one who read the evidence, records fault
/// explicitly; the resolution merely supplies the default.
///
/// NONE is the common case and carries no trust consequence at all.
enum DisputeFaultParty {
  NONE
  CLIENT
  WORKER
}

/// A dispute over a job's escrow (PAY-03, ADM-05).
///
/// Opening one FREEZES the associated escrow (state → DISPUTED) so funds cannot
/// move until an admin resolves it — enforced by the escrow state machine, which
/// only allows a hold to leave DISPUTED via a SYSTEM (admin) transition, never a
/// party's own start/complete/confirm call.
model Dispute {
  id           String  @id @default(uuid()) @db.Uuid
  jobId        String  @db.Uuid
  /// The booking whose escrow this dispute freezes. The anchor is the job (per the
  /// SRS entity), but the money hangs off the booking, so both are kept.
  bookingId    String  @db.Uuid
  escrowHoldId String? @db.Uuid

  /// The party who opened it (client or worker) — the IDENTITY, not a role.
  openedById String @db.Uuid
  reason     String

  status         DisputeStatus      @default(OPEN)
  resolution     DisputeResolution?
  /// The admin's resolution note, shown to both parties with the outcome.
  resolutionNote String?
  /// Who the admin found at fault, driving the DISPUTE_UPHELD trust penalty.
  /// Persisted rather than left in the emitted event: the trust ledger records
  /// that a penalty was applied, and this records the finding it was applied for.
  faultParty     DisputeFaultParty  @default(NONE)

  resolvedById String?   @db.Uuid
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  escrowHold EscrowHold? @relation(fields: [escrowHoldId], references: [id], onDelete: SetNull)
  openedBy   User        @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy User?       @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  messages DisputeMessage[]

  /// One live dispute per booking, enforced by a partial unique index in the
  /// migration (WHERE status <> 'RESOLVED'): a booking can be disputed again after
  /// a resolution, but never carry two open disputes at once.
  @@index([bookingId])
  /// The admin dispute queue (ADM-05).
  @@index([status, createdAt])
  @@index([jobId])
}

/// A message in a dispute thread (PAY-03 "store messages + evidence"). Either
/// party or the resolving admin posts; evidence rides along as attachments.
model DisputeMessage {
  id        String @id @default(uuid()) @db.Uuid
  disputeId String @db.Uuid
  authorId  String @db.Uuid

  body String

  createdAt DateTime @default(now())

  dispute     Dispute             @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author      User                @relation("DisputeMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachments DisputeAttachment[]

  @@index([disputeId, createdAt])
}

/// Evidence attached to a dispute message (PAY-03). A MediaAsset FK, like every
/// other attachment, so it goes through the same upload validation, ownership and
/// signed-access rules — a URL column would be the one way to skip them.
model DisputeAttachment {
  id               String @id @default(uuid()) @db.Uuid
  disputeMessageId String @db.Uuid
  mediaAssetId     String @db.Uuid

  createdAt DateTime @default(now())

  disputeMessage DisputeMessage @relation(fields: [disputeMessageId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([disputeMessageId, mediaAssetId])
  @@index([mediaAssetId])
}

/// A user's wallet (PAY-05). One per identity — money attaches to the person, not
/// a role, exactly like tier and Trust Score.
model Wallet {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  /// Withdrawable balance in whole XAF. Kept in step with the Transaction ledger
  /// inside every money transaction and CHECK-constrained non-negative in the
  /// migration; the in-escrow figure is NOT stored here — it is derived from live
  /// EscrowHold rows so the two can never drift.
  availableBalance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews (PROMPT 79; SRS §3.7 REV-01…REV-03).
//
// Reviews are the Marketplace pillar's main input, which makes them worth
// forging — so three rules hold this area up:
//
//   1. A REVIEW IS EARNED, NOT WRITTEN. A row can only exist for a job that
//      actually completed, authored by one of that job's two real participants,
//      about the other one. That is enforced in the service against the booking,
//      and backstopped here by @@unique([jobId, authorId]) so one engagement can
//      never yield two reviews from the same person. "Reviews tied to real
//      completed jobs to prevent fabrication" (REV-02) is the requirement; the
//      unique index is what makes it true under a double-tap on a bad connection.
//
//   2. MODERATION HIDES, IT DOES NOT DELETE. A reported review that breaks policy
//      goes to HIDDEN and stops counting toward the average and the trust ledger,
//      but the row and its history remain — a subject must not be able to make an
//      inconvenient review disappear, and an admin must be able to explain later
//      what was taken down and why.
//
//   3. THE TRUST CONSEQUENCE IS AN EVENT, NOT A COLUMN. A qualifying review
//      appends EXCELLENT_REVIEW to the ledger and hiding it appends
//      EXCELLENT_REVIEW_REVOKED. The score itself is never written from here.
//
// Reporting is NOT modelled here: reports live in AbuseReport with
// targetType = REVIEW, so one moderation workspace covers every reportable
// surface rather than reviews having a private queue of their own (ADM-08).
// ─────────────────────────────────────────────────────────────────────────────

/// Whether a review counts. HIDDEN is a moderation outcome (REV-03) — the row
/// survives, its influence does not.
enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// A rating and review of one job participant by the other (REV-01, REV-02).
model Review {
  id String @id @default(uuid()) @db.Uuid

  /// The completed job being reviewed — the anchor, per the SRS entity.
  jobId     String @db.Uuid
  /// The engagement that proves it happened. The job is what the review is
  /// ABOUT; the booking is the evidence that these two people transacted and
  /// that the work reached a completed state. Denormalised alongside the job so
  /// the eligibility check and the "verified purchase" marker are one read.
  bookingId String @db.Uuid

  /// Both identities, never role rows: a client reviews a worker and a worker
  /// may review the client back, and the same person is author on one row and
  /// subject on the other.
  authorId  String @db.Uuid
  subjectId String @db.Uuid

  /// 1–5 stars. Range-validated in the DTO and CHECK-constrained in the
  /// migration — the Trust Engine reads this, so a 7 must be impossible rather
  /// than merely unexpected.
  rating Int
  /// Optional: REV-01 asks for stars plus a review, and forcing prose out of a
  /// satisfied client is how a five-star rating turns into "ok".
  text   String?

  status ReviewStatus @default(PUBLISHED)

  /// Set when moderation hides a review (REV-03). Staff-facing.
  hiddenReason  String?
  moderatedById String?   @db.Uuid
  moderatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job         Job     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author      User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject     User    @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  moderatedBy User?   @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  photos ReviewPhoto[]

  /// One review per person per job. The anti-fabrication guarantee (REV-02).
  @@unique([jobId, authorId])
  /// The profile Reviews tab: a subject's visible reviews, newest first (REV-02).
  @@index([subjectId, status, createdAt])
  /// "Have I already reviewed this?" on the author's completed-jobs list.
  @@index([authorId, createdAt])
  @@index([bookingId])
}

/// A photo attached to a review (REV-01).
///
/// A MediaAsset FK rather than a URL column, for the reason spelled out on
/// BusinessProfile.logoAssetId: a URL column would be the one path into the
/// system that skips upload validation, ownership and signed access.
model ReviewPhoto {
  id           String @id @default(uuid()) @db.Uuid
  reviewId     String @db.Uuid
  mediaAssetId String @db.Uuid

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  review     Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([reviewId, mediaAssetId])
  @@index([reviewId, sortOrder])
  @@index([mediaAssetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging (PROMPT 70; SRS §13, MSG-01, MSG-02, MSG-04).
//
// A conversation is a private thread between two identities, usually anchored to
// a job. Three decisions carry this area:
//
//   1. PARTICIPANTS ARE A JOIN, NOT TWO COLUMNS. A ConversationParticipant row
//      per member means a safety/oversight OBSERVER can be added to an existing
//      thread later (MSG oversight) without reshaping the conversation — the
//      "nullable participants for later oversight" the prompt asks for.
//
//   2. EVERY MESSAGE CARRIES A KIND. Text, image, voice, a shared location, or a
//      card that embeds a quote/job/payment. The kind decides how the client
//      renders it; `body` holds text, an Attachment holds media, and `metadata`
//      holds the referenced id for the card kinds — never a second copy of the
//      quote/job/payment itself, which would drift from the source of truth.
//
//   3. DELIVERY AND READ ARE PER MESSAGE AND PER PARTICIPANT. `Message.status`
//      is the sender-visible tick (SENT → DELIVERED → READ); a participant's
//      `lastReadAt` is what a "3 unread" badge is computed from. Both, because
//      one cannot answer the other's question.
// ─────────────────────────────────────────────────────────────────────────────

/// What a message is, which is how the client renders it (MSG-01). A closed list
/// rather than a free-text type, so a new bubble shape is a reviewed schema change.
enum MessageKind {
  TEXT
  IMAGE
  VOICE
  /// A shared pin — lat/lng ride in `metadata`, not in the message body.
  LOCATION
  /// A card embedding a quote/job/payment by id (in `metadata`), so the bubble
  /// always reflects the live record rather than a snapshot that can go stale.
  QUOTE
  JOB
  PAYMENT
}

/// The sender-facing delivery tick (MSG-02). DELIVERED once the recipient's
/// socket has the message; READ once they have opened the thread.
enum MessageStatus {
  SENT
  DELIVERED
  READ
}

/// A member's part in a conversation. OBSERVER is the oversight seam (MSG): a
/// safety agent added to a thread reads but is not a negotiating party.
enum ConversationParticipantRole {
  MEMBER
  OBSERVER
}

/// Why a conversation or message was reported (MSG-04). Coded, not free text, so
/// the moderation queue can filter and the localized copy lives in the catalogue.
/// Appended, never reordered: Postgres can only APPEND to an enum, so the file
/// order must match the order the migrations added them or deploy reports drift.
/// The last four arrived with universal reporting — a fake profile or a stolen
/// portfolio photo is a different offence from chat spam, and collapsing them
/// into OTHER is what makes a moderation queue unsortable.
enum AbuseReportReason {
  SPAM
  HARASSMENT
  SCAM
  INAPPROPRIATE
  OFF_PLATFORM
  OTHER
  FAKE_PROFILE
  STOLEN_CONTENT
  MISLEADING
  ILLEGAL
}

/// What a report points at (ADM-08). A report is polymorphic — a user can report
/// anything they can see — so the target is a (type, id) pair rather than a column
/// per reportable model, which would need a migration for every new surface.
///
/// The pair is deliberately NOT a foreign key: the queue must survive the reported
/// item being deleted (that is often the outcome), and `reportedUserId` always
/// resolves the identity so an admin can still act on the person afterwards.
enum ReportTargetType {
  USER
  WORKER_PROFILE
  BUSINESS_PROFILE
  JOB
  PORTFOLIO_ITEM
  MEDIA_ASSET
  REVIEW
  QUOTE
  MESSAGE
  CONVERSATION
}

/// What an admin did about a report (ADM-08). Recorded as its own row rather than
/// a column on the report, because one decision usually settles MANY reports about
/// the same item — that is the whole point of grouping the queue by target.
enum ModerationActionType {
  /// Formal warning to the reported identity; the content stays up.
  WARN
  /// The item was taken down (soft-deleted / archived) but the account stands.
  CONTENT_REMOVED
  /// Time-boxed suspension; `expiresAt` carries the end.
  SUSPEND
  /// Permanent suspension — the fake-document outcome in TRU-08.
  BAN
  /// Lifts a suspension or ban.
  REINSTATE
  /// Reviewed and found to need nothing. Closes the group without penalty.
  DISMISS
}

enum AbuseReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

/// A private thread between identities (MSG-01), usually anchored to a job.
model Conversation {
  id String @id @default(uuid()) @db.Uuid

  /// The job this conversation is about (MSG-01 "job-linked"). Nullable so a
  /// support/oversight thread can exist without one.
  jobId String? @db.Uuid

  /// Denormalised last-message summary so a conversation list renders without a
  /// correlated subquery per row. Rewritten inside the send transaction.
  lastMessageAt      DateTime?
  lastMessagePreview String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  reports      AbuseReport[]

  @@index([jobId])
  /// The inbox list ordering: most recently active first.
  @@index([lastMessageAt])
}

/// One identity's membership of one conversation (MSG-01). The unread badge and
/// the two-party authorisation both read this — a message is visible only to
/// members, checked in the WHERE, not just by a capability.
model ConversationParticipant {
  id             String                      @id @default(uuid()) @db.Uuid
  conversationId String                      @db.Uuid
  userId         String                      @db.Uuid
  role           ConversationParticipantRole @default(MEMBER)

  /// The read watermark: messages after this instant are unread for this member.
  lastReadAt DateTime?
  /// Muted threads still receive messages but suppress the member's notifications.
  mutedAt    DateTime?
  /// A member who left a thread keeps their history but stops receiving new ones.
  leftAt     DateTime?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  /// One membership per identity per conversation.
  @@unique([conversationId, userId])
  /// The inbox read path: one identity's conversations.
  @@index([userId, conversationId])
}

/// A message in a conversation (MSG-01, MSG-02).
model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  senderId       String @db.Uuid

  kind MessageKind @default(TEXT)
  /// The text body for TEXT, or a caption for media. Null for a bare attachment
  /// or a location pin.
  body String?

  /// The object key of a single primary attachment (image/voice), mirrored onto
  /// the message for the common one-file case; richer sets use MessageAttachment.
  /// Kept as a key rather than a URL so access is decided at read time.
  mediaKey String?

  /// Referenced ids and coordinates for the card/location kinds (never a copy of
  /// the referenced record). e.g. { quoteId }, { jobId }, { bookingId }, { lat, lng }.
  metadata Json?

  status MessageStatus @default(SENT)

  deliveredAt DateTime?
  readAt      DateTime?
  /// Soft delete: a removed message leaves a "message deleted" placeholder rather
  /// than a hole in a thread the other party may have already replied to.
  deletedAt   DateTime?

  createdAt DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  reports      AbuseReport[]

  /// The thread read path: one conversation's messages in order.
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

/// A file attached to a message (MSG-01). A MediaAsset FK, like every other
/// attachment, so it goes through the same upload validation, ownership and
/// signed-access rules — a URL column would be the one way to skip them.
model MessageAttachment {
  id           String @id @default(uuid()) @db.Uuid
  messageId    String @db.Uuid
  mediaAssetId String @db.Uuid

  createdAt DateTime @default(now())

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([messageId, mediaAssetId])
  @@index([messageId])
}

/// One identity blocking another (MSG-04). A directional pair: A blocking B does
/// not block A for B, but the messaging service refuses a send in either
/// direction once a live block exists between the two.
model Block {
  id        String @id @default(uuid()) @db.Uuid
  blockerId String @db.Uuid
  blockedId String @db.Uuid

  reason String?

  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  /// One block per ordered pair; re-blocking is idempotent.
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A report of a conversation, a message, or a user (MSG-04). Feeds the admin
/// moderation queue; one model rather than three because the workflow (open →
/// review → action/dismiss) is identical whatever the target.
model AbuseReport {
  id         String @id @default(uuid()) @db.Uuid
  reporterId String @db.Uuid

  /// The identity being reported, always resolved so the queue can act on the
  /// person even when the specific message is later deleted.
  reportedUserId String @db.Uuid

  /// What was reported. The grouping key of the whole moderation workspace:
  /// twelve reports about one photo are ONE case, not twelve.
  ///
  /// Not an FK by design — see ReportTargetType. For a USER report, `targetId`
  /// equals `reportedUserId`, so the group key is uniform across every type.
  targetType ReportTargetType
  targetId   String           @db.Uuid

  /// Kept as real relations because messaging reports predate the generic target
  /// and the thread view still joins them for context in the admin case view.
  conversationId String? @db.Uuid
  messageId      String? @db.Uuid

  reason  AbuseReportReason
  details String?
  status  AbuseReportStatus @default(OPEN)

  reviewedById String?   @db.Uuid
  reviewNote   String?
  reviewedAt   DateTime?

  /// The decision that settled this report. Shared with every other report in the
  /// same group, which is how one action closes a whole case.
  moderationActionId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter         User              @relation("AbuseReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser     User              @relation("AbuseReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewedBy       User?             @relation("AbuseReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  conversation     Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message          Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  moderationAction ModerationAction? @relation(fields: [moderationActionId], references: [id], onDelete: SetNull)

  /// The moderation queue (newest open first).
  @@index([status, createdAt])
  @@index([reportedUserId])
  /// The grouped workspace: every report about one item, open ones first.
  @@index([targetType, targetId, status])
  /// A reporter cannot spam the same message twice.
  @@index([reporterId, createdAt])
  @@index([moderationActionId])
}

/// An admin decision taken against an identity and/or an item (ADM-08).
///
/// Append-only and auditable: a suspension is never a silent `User.status` write.
/// The row records who decided, why, against whom, over what, and until when — so
/// "why is this account suspended?" has an answer, and REINSTATE is a new row
/// rather than an edit that erases the history.
model ModerationAction {
  id String @id @default(uuid()) @db.Uuid

  /// The identity the action lands on — the "concerned party".
  subjectUserId String @db.Uuid
  /// The admin who decided.
  actorId       String @db.Uuid

  action ModerationActionType

  /// The item that triggered it, when the action was about content. Null for a
  /// pure account action (a ban that followed a pattern rather than one item).
  targetType ReportTargetType?
  targetId   String?          @db.Uuid

  /// Shown to the reported party — a penalty they cannot read is not due process.
  reason String
  /// Admin-only working note.
  internalNote String?

  /// When a SUSPEND lapses. Null on a BAN (permanent) and on every other action.
  expiresAt DateTime?

  createdAt DateTime @default(now())

  subject User @relation("ModerationSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  actor   User @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)

  reports AbuseReport[]

  /// A party's moderation history, newest first.
  @@index([subjectUserId, createdAt])
  /// The item's decision history in the grouped workspace.
  @@index([targetType, targetId])
  /// The lapse sweep for time-boxed suspensions.
  @@index([action, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Safety & SOS (PROMPT 73; SOS-01, SOS-02, SOS-03).
//
// An SOS alert is an auditable safety event: triggering it captures the person's
// position and fans it out to their emergency contacts and/or the safety process,
// and every alert stays on file with its resolution so a pattern is visible.
//
// The location follows the same rule as every other coordinate in the system: a
// GIST-indexed geography column derived from plain lat/lng by a trigger, so the
// alert's position is queryable on the same authoritative geometry as everything
// else. Recipients are recorded per alert (SOSAlertShare) so "who was told, and
// how" is answerable — a safety feature that cannot prove it notified anyone is
// not a safety feature.
// ─────────────────────────────────────────────────────────────────────────────

enum SOSStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

/// A person a user nominates to be alerted in an emergency (SOS-02). Phone is
/// E.164 at capture so SMS/WhatsApp fan-out flips on later with no call-site
/// change, exactly like every other phone in the system.
model EmergencyContact {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  name         String
  phone        String
  /// How they know the user ("brother", "landlord"). Free text — a nominee is
  /// whoever the user trusts, not a taxonomy.
  relationship String?
  /// The contact's own account, when they have one, so an in-app alert can reach
  /// them directly rather than only by phone.
  email        String?

  /// Soft-disabled rather than deleted so a past alert's share record keeps
  /// resolving to the contact it actually reached.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares SOSAlertShare[]

  @@index([userId, isActive])
}

/// A triggered safety alert (SOS-01, SOS-03).
model SOSAlert {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @db.Uuid
  status SOSStatus @default(ACTIVE)

  /// Where the person was when they triggered it. Plain floats are the writable
  /// source of truth; `location` is derived by the trustpro_sync_location trigger
  /// and GIST-indexed, like every other coordinate (SRS §12).
  latitude  Float?
  longitude Float?
  accuracy  Float?
  location  Unsupported("geography(Point, 4326)")?

  /// Optional free-text the user added ("being followed near Akwa").
  message String?

  /// The job/booking in progress when it was triggered, for context in the
  /// safety review. Nullable — an alert can be raised outside any job.
  jobId     String? @db.Uuid
  bookingId String? @db.Uuid

  resolvedById   String?   @db.Uuid
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation("SOSAlertUser", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?           @relation("SOSAlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  job        Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  booking    Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  shares     SOSAlertShare[]
  events     SOSAlertEvent[]

  /// The user's own SOS history, newest first (SOS-03).
  @@index([userId, createdAt])
  /// The safety team's live-alert queue.
  @@index([status, createdAt])
}

/// Who an alert was shared with, and whether the share reached them (SOS-01).
/// The auditable proof that an alert actually notified someone.
model SOSAlertShare {
  id                 String  @id @default(uuid()) @db.Uuid
  sosAlertId         String  @db.Uuid
  /// The nominated contact this share went to. Null for a share to the internal
  /// safety process rather than a personal contact.
  emergencyContactId String? @db.Uuid

  /// How it was sent ("email", "console", "sms"). The dispatcher owns the actual
  /// send; this records the outcome for the audit trail.
  channel   String
  delivered Boolean   @default(false)
  error     String?
  sentAt    DateTime?

  createdAt DateTime @default(now())

  sosAlert         SOSAlert          @relation(fields: [sosAlertId], references: [id], onDelete: Cascade)
  emergencyContact EmergencyContact? @relation(fields: [emergencyContactId], references: [id], onDelete: SetNull)

  @@index([sosAlertId])
}

/// Every move an alert made through its states (SOS-03). Append-only — the
/// tamper-evident safety trail, the same discipline as the money and job logs.
model SOSAlertEvent {
  id         String @id @default(uuid()) @db.Uuid
  sosAlertId String @db.Uuid

  fromStatus SOSStatus?
  toStatus   SOSStatus

  /// Null for system transitions. Set to the resolving safety agent otherwise.
  actorId   String? @db.Uuid
  note      String?
  requestId String?

  createdAt DateTime @default(now())

  sosAlert SOSAlert @relation(fields: [sosAlertId], references: [id], onDelete: Cascade)

  @@index([sosAlertId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Live tracking (PROMPT 74; SOS-03; CLAUDE.md SPATIAL "foreground streaming").
//
// A tracking session lets a worker's live position stream to a consented client
// while the tracking screen is open. The web has no reliable background tracking,
// so this is FOREGROUND streaming with EXPLICIT, REVOCABLE consent:
//
//   • A session names the tracked subject, the consented viewer and the booking.
//   • Consent is a timestamp pair (granted/revoked); revoking ends the fan-out
//     immediately and no further pings are accepted for that viewer.
//   • Pings persist to PostGIS (same trigger, same GIST index) so a route is
//     replayable for a safety review — a session is not only a live channel.
// ─────────────────────────────────────────────────────────────────────────────

enum TrackingSessionStatus {
  ACTIVE
  ENDED
}

/// One consented live-tracking channel around a booking (SOS-03).
model TrackingSession {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid

  /// The identity being tracked (the worker travelling to the job) and the one
  /// permitted to watch (the client). Both are identities, not roles.
  subjectId String @db.Uuid
  viewerId  String @db.Uuid

  status TrackingSessionStatus @default(ACTIVE)

  /// Where the subject is heading, so ETA/distance can be computed server-side
  /// against the authoritative geometry rather than trusted from the client.
  destinationLat Float?
  destinationLng Float?

  /// Explicit, revocable consent (CLAUDE.md SPATIAL). `consentRevokedAt` set ⇒
  /// the fan-out stops and ingestion is refused, even before the session ends.
  consentGrantedAt DateTime  @default(now())
  consentRevokedAt DateTime?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  subject User           @relation("TrackingSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  viewer  User           @relation("TrackingViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  pings   LocationPing[]

  /// At most one live session per booking + viewer pair (partial unique in the
  /// migration on status = 'ACTIVE'): re-opening the screen resumes rather than
  /// forking a second channel.
  @@index([bookingId, status])
  @@index([subjectId, status])
  @@index([viewerId, status])
}

/// One position report on a tracking session (SOS-03). Persisted so a route is
/// replayable; the live fan-out reads the latest row, the safety review the whole
/// trail.
model LocationPing {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  /// The subject the ping is FOR — denormalised so a per-user position history is
  /// one indexed scan without walking the session.
  userId    String @db.Uuid

  latitude  Float
  longitude Float
  location  Unsupported("geography(Point, 4326)")?

  /// GPS quality signals from the browser Geolocation API, kept for the review.
  accuracy Float?
  heading  Float?
  speed    Float?

  /// When the browser fixed the position (may lag the row's createdAt on a slow
  /// connection). The ordering key for "latest position".
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation("LocationPingUser", fields: [userId], references: [id], onDelete: Cascade)

  /// The live read path: the latest ping on a session.
  @@index([sessionId, recordedAt])
  @@index([userId, recordedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Web-push device registry (PROMPT 76; NOT-01, SRS §26.1).
//
// A user reads TrustPro on several devices (phone browser, laptop). Web push
// targets a SUBSCRIPTION (endpoint + VAPID keys), not a user, so one identity has
// many registrations. A push that fails because the browser dropped the
// subscription deactivates the row (isActive=false) so the dispatcher stops
// aiming at a dead endpoint — the "deactivate expired subscriptions" the prompt
// asks for.
// ─────────────────────────────────────────────────────────────────────────────

/// The client platform a subscription belongs to. Only WEB at launch (PWA), but
/// modelled so a future channel is an appended value, not a schema reshape.
enum DevicePlatform {
  WEB
}

/// One web-push subscription for one device (NOT-01). `endpoint` is globally
/// unique — it IS the address the push service delivers to, and a re-subscribe on
/// the same browser upserts this row rather than piling up dead duplicates.
model DeviceRegistration {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @db.Uuid
  platform DevicePlatform @default(WEB)

  /// The push-service endpoint URL (unique). The subscription's identity.
  endpoint String @unique
  /// The subscription's public key and auth secret (Web Push encryption). Stored
  /// so the server can encrypt payloads; useless without the private VAPID key.
  p256dh   String
  auth     String

  /// Coarse device label for the user's "signed-in devices" list; never a
  /// fingerprint.
  deviceName String?

  /// Deactivated on the first delivery failure (410 Gone / 404) so the dispatcher
  /// stops selecting it. Kept rather than deleted for the device-history view.
  isActive Boolean @default(true)

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The dispatcher's lookup: a user's live subscriptions.
  @@index([userId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin operations (PROMPT 87, 88; ADM-02, ADM-06, ADM-07).
//
// Deliberately absent from this section: any "risk score" or "fraud flag" table.
// The Fraud & Risk monitor (ADM-06) is a DERIVED read over facts that already
// exist — suspended trust scores, lost disputes, open reports, account status —
// because a stored risk verdict is a number nobody recomputes and everybody
// trusts. Blocking an account is an existing ModerationAction, not a new row.
// ─────────────────────────────────────────────────────────────────────────────

/// Where an agent invitation is in its life (ADM-06, meeting-notes admin invites
/// agents). REVOKED is the admin withdrawing it; EXPIRED is the clock running
/// out. Distinct states because "why can't this person sign up" has different
/// answers and different remedies.
enum AgentInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// An admin's invitation for someone to join as a field AGENT (ADM-06).
///
/// Agents cannot self-register: a field agent physically verifies workers, which
/// is the most abusable capability on the platform, so the only route in is an
/// admin creating this row. The invitation carries the contact details and a
/// one-time token; the agent identity is created when the token is accepted, and
/// `acceptedUserId` binds the two afterwards.
model AgentInvitation {
  id    String  @id @default(uuid()) @db.Uuid
  name  String
  email String
  /// E.164, normalised at capture so SMS delivery can be switched on later.
  phone String?

  /// Hashed, never stored raw — an invitation token is a credential, and a
  /// leaked invitations table must not hand out agent accounts.
  tokenHash String @unique

  status AgentInvitationStatus @default(PENDING)

  invitedById String @db.Uuid
  /// Bound on acceptance. NULL while outstanding: there is no identity yet.
  acceptedUserId String? @db.Uuid

  /// Free-text note from the admin ("Douala field team, starts Monday").
  note String?

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  invitedBy    User  @relation("AgentInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedUser User? @relation("AgentInvitationAcceptor", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  /// The admin console lists outstanding invitations first.
  @@index([status, createdAt])
  @@index([email])
}

/// Who an announcement is aimed at (ADM-07). Targeting by ROLE rather than by a
/// saved user list: the audience of "all workers" changes every day, and a
/// materialised recipient list would be stale the moment it was written.
enum AnnouncementAudience {
  ALL
  WORKERS
  CLIENTS
  BUSINESSES
  AGENTS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A platform announcement (ADM-07).
///
/// Both languages are REQUIRED columns rather than a translations side-table.
/// The platform is bilingual EN/FR by requirement, and an announcement that
/// exists in one language is one that half the users cannot read — making the
/// second language a nullable extra is how that happens.
model Announcement {
  id String @id @default(uuid()) @db.Uuid

  titleEn String
  titleFr String
  bodyEn  String
  bodyFr  String

  audience AnnouncementAudience @default(ALL)
  status   AnnouncementStatus   @default(DRAFT)

  /// Shows in the app until this instant. NULL means it stays until archived.
  expiresAt   DateTime?
  publishedAt DateTime?

  authorId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// The reader's query: what is live for my audience, newest first.
  @@index([status, audience, publishedAt])
}

/// One piece of platform configuration (ADM-07).
///
/// Key/value with a JSON payload rather than a wide typed table: the settings
/// surface grows every release, and a schema migration per toggle is the reason
/// settings screens ossify. `category` groups them for the console; `updatedById`
/// and `updatedAt` are what make a surprising production value traceable to a
/// person — and every write is additionally mirrored into AuditLog.
///
/// SECRETS DO NOT LIVE HERE. Provider keys stay in the managed secret store; this
/// table holds the switches and thresholds an admin is meant to see.
model SystemSetting {
  key      String @id
  value    Json
  category String @default("general")

  /// What this controls, shown beside the field in the console.
  description String?

  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation("SystemSettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketing content (PROMPT 92.1; SRS §26.2).
//
// The landing page's FAQ and testimonials are DATABASE-DRIVEN, never hardcoded
// arrays. That is a stated frontend system rule, and the reason is operational
// rather than architectural: marketing copy changes on a marketing team's
// schedule, and copy that only an engineer can edit is copy that goes stale.
//
// Both models carry EN and FR as REQUIRED columns rather than a translations
// side-table, following Announcement above and for the same reason: the platform
// is bilingual by requirement (SYS-03), and a nullable second language is how
// half the audience ends up reading the other half's language.
// ─────────────────────────────────────────────────────────────────────────────

/// One question/answer pair on the marketing FAQ (SRS §26.2).
model Faq {
  id String @id @default(uuid()) @db.Uuid

  questionEn String
  questionFr String

  /// Markdown. Answers need links and the occasional list — storing rendered
  /// HTML instead would put an XSS sink in an admin-editable column.
  answerEn String
  answerFr String

  /// Optional grouping ("payments", "verification"). Free text rather than an
  /// enum: the FAQ is edited by non-engineers, and a new group must not require
  /// a migration.
  category String?

  /// Admin-chosen display order, ascending.
  order Int @default(0)

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The public read: what is published, in order. Also serves the admin list,
  /// which filters on nothing and sorts the same way.
  @@index([isPublished, order])
  @@index([category, order])
}

/// A published customer testimonial (SRS §26.2).
model Testimonial {
  id String @id @default(uuid()) @db.Uuid

  /// Shown verbatim; not a User relation. A testimonial outlives the account
  /// that gave it, and joining to a live profile would let a later display-name
  /// change silently rewrite a quote someone approved.
  author String

  roleEn String
  roleFr String

  /// Nullable: initials render when absent, so a missing photo is never a
  /// broken image on the conversion surface.
  avatarUrl String?

  contentEn String
  contentFr String

  /// 0.0–5.0. Decimal, not Int, because the rule is explicit that ratings render
  /// with half-stars (4.3 -> 4 full + 1 half) — rounding at write time would
  /// destroy the very precision the display is specified to show.
  rating Decimal @db.Decimal(2, 1)

  order   Int     @default(0)
  visible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

/// A before/after entry in the landing page's Portfolio showcase (SRS §26.2).
model PortfolioShowcase {
  id String @id @default(uuid()) @db.Uuid

  tradeEn   String
  tradeFr   String
  captionEn String
  captionFr String

  /// Plain storage/CDN URLs, same shape as Testimonial.avatarUrl — an admin
  /// pastes a URL rather than this being a MediaAsset relation, so a photo
  /// can be swapped without an upload round-trip.
  beforeUrl String
  afterUrl  String

  /// Admin-chosen display order, ascending.
  order Int @default(0)

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The public read: what is published, in order. Also serves the admin
  /// list, which filters on nothing and sorts the same way.
  @@index([isPublished, order])
}
