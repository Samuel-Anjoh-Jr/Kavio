{
  "name": "@kavio/database",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "prisma": {
    "seed": "node ./prisma/seed.mjs"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "push": "prisma db push",
    "studio": "prisma studio",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-url \"$DIRECT_URL\" --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "seed": "node ./prisma/seed.mjs",
    "osm:ingest": "node ./scripts/ingest-osm.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@prisma/client": "^6.3.1",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@kavio/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "prisma": "^6.3.1",
    "typescript": "^5.7.3"
  }
}
