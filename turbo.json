{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "PORT",
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "MAINTENANCE_MODE",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "JWT_ISSUER",
    "JWT_AUDIENCE",
    "AUTH_SECRET_PEPPER",
    "AUTH_SECRET",
    "AUTH_TRUST_HOST",
    "API_INTERNAL_URL",
    "APP_BASE_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "NEXT_PUBLIC_SITE_URL",
    "CORS_ALLOWED_ORIGINS",
    "NEXT_PUBLIC_SOCIAL_FACEBOOK",
    "NEXT_PUBLIC_SOCIAL_INSTAGRAM",
    "NEXT_PUBLIC_SOCIAL_LINKEDIN",
    "NEXT_PUBLIC_SOCIAL_X",
    "NEXT_PUBLIC_SOCIAL_YOUTUBE",
    "NEXT_PUBLIC_TWITTER_HANDLE",
    "NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION",
    "NEXT_PUBLIC_BING_SITE_VERIFICATION",
    "OTP_CODE_LENGTH",
    "OTP_TTL_SECONDS",
    "OTP_MAX_ATTEMPTS",
    "OTP_RESEND_COOLDOWN_SECONDS",
    "OTP_MAX_PER_WINDOW",
    "OTP_WINDOW_SECONDS",
    "PASSWORD_RESET_TTL_SECONDS",
    "PASSWORD_RESET_PATH",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "CAMPAY_BASE_URL",
    "CAMPAY_APP_USERNAME",
    "CAMPAY_APP_PASSWORD",
    "CAMPAY_WEBHOOK_KEY",
    "CAMPAY_CALLBACK_URL",
    "CAMPAY_DEMO_AMOUNT_XAF",
    "PLATFORM_FEE_BPS",
    "VERIFICATION_OCR_ENABLED",
    "VERIFICATION_OCR_MIN_CONFIDENCE",
    "SAFETY_ALERT_EMAIL",
    "MAPBOX_TOKEN",
    "NEXT_PUBLIC_MAPBOX_TOKEN",
    "CARTO_BASE_URL",
    "CARTO_API_KEY",
    "CARTO_CONNECTION_NAME",
    "GEO_TILE_CACHE_TTL_SECONDS",
    "BIGDATACLOUD_KEY",
    "BIGDATACLOUD_BASE_URL",
    "BIGDATACLOUD_TIMEOUT_MS",
    "GEO_REVERSE_CACHE_TTL_SECONDS",
    "OSM_OVERPASS_URL",
    "RESEND_API_KEY",
    "NOTIFICATIONS_EMAIL_PROVIDER",
    "NOTIFICATIONS_EMAIL_FROM",
    "NOTIFICATIONS_SMS_ENABLED",
    "NOTIFICATIONS_WHATSAPP_ENABLED",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_SMS_FROM_NUMBER",
    "TWILIO_WHATSAPP_FROM_NUMBER",
    "NOTIFICATIONS_CHANNEL_PRIORITY",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_PUBLIC_URL",
    "S3_SIGNED_URL_TTL_SECONDS",
    "S3_KYC_KMS_KEY_ID",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_STORAGE_BUCKET",
    "SUPABASE_SIGNED_URL_TTL_SECONDS",
    "BLOB_READ_WRITE_TOKEN",
    "BLOB_STORE_ID",
    "BLOB_WEBHOOK_PUBLIC_KEY"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
